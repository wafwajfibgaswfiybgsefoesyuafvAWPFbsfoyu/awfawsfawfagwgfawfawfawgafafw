    local function WaitForWrapAsset(wrapName, timeout)
        timeout = timeout or 5;
        local start = os.clock();
        local ps = LocalPlayer:FindFirstChild("PlayerScripts");
        if not ps then return false end;
        local assets = ps:FindFirstChild("Assets");
        if not assets then return false end;
        local misc = assets:FindFirstChild("Misc");
        if not misc then return false end;
        while (os.clock() - start) < timeout do
            if misc:FindFirstChild("Wrap") then return true end;
            task.wait(0.15);
        end;
        return false;
    end;
    local function WaitForCharmAsset(charmName, timeout)
        timeout = timeout or 5;
        local start = os.clock();
        local ps = LocalPlayer:FindFirstChild("PlayerScripts");
        if not ps then return false end;
        local assets = ps:FindFirstChild("Assets");
        if not assets then return false end;
        local charmsFolder = assets:FindFirstChild("Charms");
        if not charmsFolder then return false end;
        while (os.clock() - start) < timeout do
            if charmsFolder:FindFirstChild(charmName) then return true end;
            task.wait(0.15);
        end;
        return false;
    end;

    function ApplyWrap(WeaponName, WrapName)
        if not WeaponName or WeaponName == "" then return end;
        task.spawn(function()
            if WrapName and WrapName ~= "" then
                if not WaitForWrapAsset(WrapName, 5) then
                    if Library and Library.Notify then
                        Library:Notify(string.format("'%s' wrap asset not loaded yet — wait a moment and try again", WrapName), 3);
                    end;
                    return;
                end;
            end;
            -- Pre-populate _OriginalVMData for skinless weapons before applying
            if not _OriginalVMData[WeaponName] then
                pcall(function()
                    local FC = require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("Controllers"):WaitForChild("FighterController"));
                    local lf = rawget(FC, "LocalFighter") or (function() local ok,f = pcall(function() return FC:GetFighter(LocalPlayer) end); if ok then return f end end)();
                    if not lf then return end;
                    local eq = rawget(lf, "EquippedItem");
                    local item = (eq and rawget(eq, "Name") == WeaponName) and eq or nil;
                    if not item then
                        pcall(function()
                            for _, v in ipairs(lf.Items or {}) do
                                if pcall(function() return v.Name end) and v.Name == WeaponName then item = v; break end;
                            end;
                        end);
                    end;
                    if not item then return end;
                    local liveVM = rawget(item, "ViewModel");
                    local liveVMData = type(liveVM) == "table" and rawget(liveVM, "Data") or nil;
                    if liveVMData then _OriginalVMData[WeaponName] = table.clone(liveVMData) end;
                end);
            end;
            PickWrap(WeaponName, WrapName);
            _LastApplyLive[WeaponName] = nil;
            if not (Skins[WeaponName] and Skins[WeaponName] ~= "") then
                -- No skin: ApplyLive won't work, force re-equip so _CreateViewModel hook fires
                pcall(function()
                    local FC = require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("Controllers"):WaitForChild("FighterController"));
                    local lf = rawget(FC, "LocalFighter") or (function() local ok,f = pcall(function() return FC:GetFighter(LocalPlayer) end); if ok then return f end end)();
                    if not lf then return end;
                    local unequip = rawget(lf, "UnequipItem") or lf.UnequipItem;
                    local equip   = rawget(lf, "EquipItem")   or lf.EquipItem;
                    local eq = rawget(lf, "EquippedItem");
                    if not eq or rawget(eq, "Name") ~= WeaponName then return end;
                    if type(unequip) == "function" and type(equip) == "function" then
                        pcall(unequip, lf, eq);
                        task.wait(0.05);
                        pcall(equip, lf, eq);
                    end;
                end);
            else
                ApplyLive(WeaponName);
            end;
            if WeaponRowRefs[WeaponName] then
                WeaponRowRefs[WeaponName].UpdateThumb();
            end;
        end);
    end;

