        local function ReapplyLiveState()
            if not WorldVisualsEnabled then return end;
            local P = CaptureProfile();
            if P.AmbientEnabled then
                Lighting.Ambient        = P.CurrentAmbient;
                Lighting.OutdoorAmbient = P.CurrentOutdoorAmb;
            end;
            Lighting.Brightness = P.Brightness;
            if P.FogEnabled then
                Lighting.FogStart = P.FogStart;
                Lighting.FogEnd   = (P.FogEnd > 0) and P.FogEnd or 500;
                Lighting.FogColor = P.FogCurrentColor;
            end;
            Lighting.TimeOfDay = P.TimeOfDay;
            local Eb = GetOrMakeBloom();
            if P.BloomEnabled then
                Eb.Enabled   = true;
                Eb.Intensity = P.BloomIntensity;
                Eb.Size      = P.BloomSize;
                Eb.Threshold = P.BloomThreshold;
            end;
            local El = GetOrMakeBlur();
            if P.BlurEnabled then
                El.Enabled = true;
                El.Size    = (P.BlurSize > 0) and P.BlurSize or 24;
            end;
            if P.SkyboxChangerEnabled and P.SelectedSkybox then
                local Cur = Lighting:FindFirstChildOfClass("Sky");
                local StillOurs = false;
                if Cur and Cur.Name and Cur.Name:match("^BobSky_") then StillOurs = true end;
                if not StillOurs then
                    for _, Data in LoadedSkyboxes do
                        if Data.name == P.SelectedSkybox then ApplySkybox(Data); break end;
                    end;
                end;
            end;
        end;

        do
            local LPlayer = game:GetService("Players").LocalPlayer;
            LPlayer.CharacterAdded:Connect(function()
                task.wait(0.6);
                pcall(ReapplyLiveState);
            end);
        end;

        task.spawn(function()
            while true do
                task.wait(1.5);
                pcall(ReapplyLiveState);
            end;
        end);
end

