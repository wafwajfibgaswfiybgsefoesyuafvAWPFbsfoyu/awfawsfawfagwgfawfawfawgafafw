local _playerMatchCache = setmetatable({}, { __mode = "k" });
local IsPlayerInLocalMatch = LPH_NO_VIRTUALIZE(function(targetPlayer)
    if not targetPlayer or targetPlayer == Client then return false end;
    local now = os_clock();
    local cached = _playerMatchCache[targetPlayer];
    if cached and (now - cached.t) < 0.5 then
        return cached.v;
    end;
    local result = false;
    pcall(function()
        local lp = Client;
        if not lp then return end;
        local okFC, fc = pcall(function()
            return require(lp:WaitForChild("PlayerScripts"):WaitForChild("Controllers"):WaitForChild("FighterController"));
        end);
        if not okFC or not fc then return end;
        local lf = fc.LocalFighter;
        if not lf then return end;
        local lfd = rawget(lf, "Data");
        if not lfd then return end;
        if not rawget(lfd, "IsInDuel") then return end;
        local myEnv = rawget(lfd, "EnvironmentID");
        if myEnv == nil then return end;
        local fighter = nil;
        if fc.GetFighter then
            local okF, f = pcall(function() return fc:GetFighter(targetPlayer) end);
            if okF and f then fighter = f end;
        end;
        if not fighter then
            local pm = fc._player_to_fighter;
            if type(pm) == "table" then
                fighter = pm[targetPlayer];
            end;
        end;
        if not fighter then return end;
        local d = rawget(fighter, "Data");
        if not d then return end;
        if not rawget(d, "IsInDuel") then return end;
        if rawget(d, "EnvironmentID") ~= myEnv then return end;
        result = true;
    end);
    _playerMatchCache[targetPlayer] = { t = now, v = result };
    return result;
end);
