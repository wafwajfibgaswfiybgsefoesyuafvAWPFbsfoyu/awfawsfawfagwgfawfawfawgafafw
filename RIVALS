        };
    else
        attackData = { hitPart };
    end;
    local equipped = lf.EquippedItem;
    local objId;
    pcall(function() objId = equipped:Get("ObjectID") end);
    if not objId then return end;
    local data = { [utf8.char(1)] = attackData };
