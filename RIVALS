            Utility = {
                ["Elixir"]=true, ["Flashbang"]=true, ["Freeze Ray"]=true, ["Grappler"]=true,
                ["Grenade"]=true, ["Jump Pad"]=true, ["Medkit"]=true, ["Molotov"]=true,
                ["RNG Dice"]=true, ["Satchel"]=true, ["Smoke Grenade"]=true, ["Subspace Tripmine"]=true,
                ["War Horn"]=true, ["Warpstone"]=true,
            },
        }
        local _vmItemLib = nil
        local _vmItemLibTried = false
        local function vmResolveItemClass(itemName)
            if not itemName or itemName == "" then return nil end
            local cached = _vmItemClassCache[itemName]
            if cached ~= nil then return cached end
            local cls = nil
            if not _vmItemLibTried then
                _vmItemLibTried = true
                pcall(function()
                    _vmItemLib = require(game:GetService("ReplicatedStorage").Modules.ItemLibrary)
                end)
            end
            pcall(function()
                local info = _vmItemLib and _vmItemLib.Items and _vmItemLib.Items[itemName]
                cls = info and info.Class or nil
            end)
