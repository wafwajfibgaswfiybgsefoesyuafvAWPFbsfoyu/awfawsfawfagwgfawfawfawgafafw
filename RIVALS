        local function MakeDualSlider(parent, Opts)
            Opts = Opts or {}
            local Name      = tostring(Opts.Name or "range")
            local Min       = tonumber(Opts.Min) or 0
            local Max       = tonumber(Opts.Max) or 100
            local Step      = tonumber(Opts.Step) or 1
            local Suffix    = tostring(Opts.Suffix or "")
            local Decimals  = tonumber(Opts.Decimals) or 0
            local FlagMin   = tostring(Opts.FlagMin or (Name .. "_min"))
            local FlagMax   = tostring(Opts.FlagMax or (Name .. "_max"))
            local ValMin    = math.clamp(tonumber(Opts.DefaultMin) or Min, Min, Max)
            local ValMax    = math.clamp(tonumber(Opts.DefaultMax) or Max, Min, Max)
            if ValMin > ValMax then ValMin, ValMax = ValMax, ValMin end
            Library.Flags[FlagMin] = ValMin
            Library.Flags[FlagMax] = ValMax
            local Callback = typeof(Opts.Callback) == "function" and Opts.Callback or function() end

            local Container = Library:CreateInstance("Frame", {
                Name                   = "DualSlider_" .. Name;
                Parent                 = parent;
                Size                   = UDim2.new(1, 0, 0, 30);
                BackgroundTransparency = 1;
                BorderSizePixel        = 0;
            })

            local Lbl = Library:CreateInstance("TextLabel", {
                Name                   = "Label";
                Parent                 = Container;
                Position               = UDim2.new(0, 0, 0, 0);
                Size                   = UDim2.new(1, -60, 0, 14);
                BackgroundTransparency = 1;
                BorderSizePixel        = 0;
                Text                   = Name;
                TextColor3             = Color3.fromHex("FFFFFF");
                TextSize               = 12;
                TextXAlignment         = Enum.TextXAlignment.Left;
                TextYAlignment         = Enum.TextYAlignment.Center;
            })
            if ProggyCleanFont then Lbl.FontFace = ProggyCleanFont end

            local ValLbl = Library:CreateInstance("TextLabel", {
                Name                   = "Value";
                Parent                 = Container;
                AnchorPoint            = Vector2.new(1, 0);
                Position               = UDim2.new(1, 0, 0, 0);
                Size                   = UDim2.new(0, 60, 0, 14);
                BackgroundTransparency = 1;
                BorderSizePixel        = 0;
                TextColor3             = Color3.fromHex("8C8F99");
                TextSize               = 12;
                TextXAlignment         = Enum.TextXAlignment.Right;
                TextYAlignment         = Enum.TextYAlignment.Center;
                Text                   = "";
            })
            if ProggyCleanFont then ValLbl.FontFace = ProggyCleanFont end

            local Track = Library:CreateInstance("TextButton", {
                Name             = "Track";
                Parent           = Container;
                AnchorPoint      = Vector2.new(0, 1);
                Position         = UDim2.new(0, 0, 1, 0);
                Size             = UDim2.new(1, 0, 0, 12);
                BackgroundColor3 = Color3.fromHex("000000");
                BorderSizePixel  = 0;
                AutoButtonColor  = false;
                Text             = "";
            })
            Library:AddSubtleGlow(Track)
            local TrackGray = Library:CreateInstance("Frame", {
                Parent           = Track;
                Position         = UDim2.new(0, 1, 0, 1);
                Size             = UDim2.new(1, -2, 1, -2);
                BackgroundColor3 = Color3.fromHex("393939");
                BorderSizePixel  = 0;
            })
            local TrackInside = Library:CreateInstance("Frame", {
                Parent           = TrackGray;
                Position         = UDim2.new(0, 1, 0, 1);
                Size             = UDim2.new(1, -2, 1, -2);
                BackgroundColor3 = Color3.fromHex("131313");
                BorderSizePixel  = 0;
            })

            local Fill = Library:CreateInstance("Frame", {
                Name             = "Fill";
                Parent           = TrackInside;
                Position         = UDim2.new(0, 1, 0, 1);
                Size             = UDim2.new(0, 0, 1, -2);
                BackgroundColor3 = Color3.fromHex("3972EC");
                BorderSizePixel  = 0;
            })
            Library:RegisterAccent(Fill)

            local function MakeHandle(anchor)
                local handle = Library:CreateInstance("TextButton", {
                    Name             = (anchor == "min" and "MinHandle" or "MaxHandle");
                    Parent           = TrackInside;
                    AnchorPoint      = Vector2.new(0.5, 0.5);
                    Position         = UDim2.new(0, 0, 0.5, 0);
                    Size             = UDim2.new(0, 10, 0, 16);
                    BackgroundColor3 = Color3.fromHex("FFFFFF");
                    BorderSizePixel  = 0;
                    AutoButtonColor  = false;
                    Text             = "";
                    ZIndex           = 6;
                })
                Library:CreateInstance("UIStroke", {
                    Parent          = handle;
                    Color           = Color3.fromHex("000000");
                    Thickness       = 1;
                    Transparency    = 0.4;
                    ApplyStrokeMode = Enum.ApplyStrokeMode.Border;
                })
                return handle
            end
            local MinHandle = MakeHandle("min")
            local MaxHandle = MakeHandle("max")

            local function FormatVal(V)
                if Decimals > 0 then
                    return string.format("%." .. Decimals .. "f", V) .. Suffix
                end
                return tostring(math.round(V)) .. Suffix
            end

            local function TFromVal(V)
                if Max <= Min then return 0 end
                return (V - Min) / (Max - Min)
            end

            local function Render()
                local tMin = TFromVal(ValMin)
                local tMax = TFromVal(ValMax)
                Fill.Position = UDim2.new(tMin, 1, 0, 1)
                Fill.Size     = UDim2.new(tMax - tMin, -2, 1, -2)
                MinHandle.Position = UDim2.new(tMin, 0, 0.5, 0)
                MaxHandle.Position = UDim2.new(tMax, 0, 0.5, 0)
                ValLbl.Text = FormatVal(ValMin) .. " - " .. FormatVal(ValMax)
            end
            Render()

            local function SetVals(newMin, newMax, fire)
                newMin = math.clamp(math.floor((newMin - Min) / Step + 0.5) * Step + Min, Min, Max)
                newMax = math.clamp(math.floor((newMax - Min) / Step + 0.5) * Step + Min, Min, Max)
                if newMin > newMax - Step then
                    if fire == "min" then
                        newMax = math.min(Max, newMin + Step)
                    elseif fire == "max" then
                        newMin = math.max(Min, newMax - Step)
                    else
                        local mid = (newMin + newMax) / 2
                        newMin = math.clamp(mid - Step/2, Min, Max)
                        newMax = math.clamp(mid + Step/2, Min, Max)
                    end
                end
                if newMin == ValMin and newMax == ValMax then return end
                ValMin, ValMax = newMin, newMax
                Library.Flags[FlagMin] = ValMin
                Library.Flags[FlagMax] = ValMax
                Render()
                if fire ~= false then Callback(ValMin, ValMax) end
            end

            local Dragging = nil
            local function UpdateFromPx(px, which)
                local AbsX, AbsW = TrackInside.AbsolutePosition.X, TrackInside.AbsoluteSize.X
                if AbsW <= 0 then return end
                local t = math.clamp((px - AbsX) / AbsW, 0, 1)
                local v = Min + t * (Max - Min)
                if which == "min" then
                    SetVals(v, ValMax, "min")
                else
                    SetVals(ValMin, v, "max")
                end
            end

            local function StartDrag(which)
                return function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        Dragging = which
                        UpdateFromPx(input.Position.X, which)
                    end
                end
            end
            local function EndDrag(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    Dragging = nil
                end
            end
            MinHandle.InputBegan:Connect(StartDrag("min"))
            MaxHandle.InputBegan:Connect(StartDrag("max"))
            MinHandle.InputEnded:Connect(EndDrag)
            MaxHandle.InputEnded:Connect(EndDrag)
            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    local AbsX, AbsW = TrackInside.AbsolutePosition.X, TrackInside.AbsoluteSize.X
                    if AbsW <= 0 then return end
                    local t = math.clamp((input.Position.X - AbsX) / AbsW, 0, 1)
                    local v = Min + t * (Max - Min)
                    if math.abs(v - ValMin) <= math.abs(v - ValMax) then
                        Dragging = "min"
                        SetVals(v, ValMax, "min")
                    else
                        Dragging = "max"
                        SetVals(ValMin, v, "max")
                    end
                end
            end)
            Track.InputEnded:Connect(EndDrag)
            UserInputService.InputChanged:Connect(function(input)
                if not Dragging then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                    UpdateFromPx(input.Position.X, Dragging)
                end
            end)

            if Opts.Tooltip then Library:Tooltip(Container, Opts.Tooltip) end

            local Obj = {
                Container = Container,
                Track = Track,
                Fill = Fill,
                MinHandle = MinHandle,
                MaxHandle = MaxHandle,
            }
            function Obj:GetMin() return ValMin end
            function Obj:GetMax() return ValMax end
            function Obj:SetMin(v) SetVals(v, ValMax, "min") end
            function Obj:SetMax(v) SetVals(ValMin, v, "max") end
            return Obj
        end

        local _fpsPingLabel = nil
        local function FindFpsPingLabel()
