            return cls
        end
        local function vmModelItemName(model)
            -- "PlayerName - ItemName - SkinName" (skin names may contain " - ")
            local name = model.Name
            local rest = name:match("^[^-]+ - (.+)$")
            if not rest then return nil end
            local item = rest:match("^(.-) - ")
            if item and item ~= "" then return item end
