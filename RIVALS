        if not equipped then return false end;
        local curIdx = nil;
        for i, v in ipairs(items) do
            if v == equipped then curIdx = i; break; end;
        end;
        if not curIdx then return false end;
        local n = #items;
        if n < 2 then return false end;
        local otherIdx = (curIdx % n) + 1;
        _LastCycleTime = now;
        pcall(function()
            lf:EquipItem(otherIdx, true);
            task.wait(0.06);
            lf:EquipItem(curIdx, true);
        end);
        task.wait(0.06);
        return true;
    end;

    function FindLiveViewModel(WeaponName)
        local wsVMs = Workspace:FindFirstChild("ViewModels");
        if not wsVMs then return nil end;
        local fp = wsVMs:FindFirstChild("FirstPerson");
        if not fp then return nil end;
        local prefix = LocalPlayer.Name .. " - ";
        local prefixLen = #prefix;
        for _, child in ipairs(fp:GetChildren()) do
            local name = child.Name;
            if string.sub(name, 1, prefixLen) == prefix then
                local rest = string.sub(name, prefixLen + 1);
                local wn = string.match(rest, "^(.+) %- .+$");
                if wn == WeaponName then
                    return child;
                end;
            end;
        end;
        return nil;
    end;

