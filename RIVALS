local function _GetPierceCount(weaponName)
    if not weaponName then return 0 end;
    local lib = nil;
    local ok = pcall(function()
        lib = require(game:GetService("ReplicatedStorage").Modules.ItemLibrary);
    end);
    if not ok or not lib or not lib.Items then return 0 end;
    local entry = lib.Items[weaponName];
    if not entry then return 0 end;
    local n = entry.RaycastPierceCount or 0;
    return tonumber(n) or 0;
end;

local function _EnsurePierceLines(n)
    for i = 1, n do
        if not _pierceLines[i] then
            local ok, ln = pcall(function() return Drawing.new("Line") end);
            if ok and ln then
                ln.Thickness = 1.5;
                ln.Color     = _pierceColor;
                ln.Transparency = _pierceTransparency;
                ln.Visible   = false;
                _pierceLines[i] = ln;
            end;
        end;
    end;
end;

local function _HideAllPierceLines()
    for _, ln in pairs(_pierceLines) do
        if ln then ln.Visible = false end;
    end;
end;

local function _DestroyPierceLines()
    for i, ln in pairs(_pierceLines) do
        if ln then pcall(function() ln:Remove() end); _pierceLines[i] = nil end;
    end;
end;

