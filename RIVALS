local _combatModItem = nil;
local function _getEquippedItem() _combatModItem = localFighter.EquippedItem end;
local function _applyCombatMods()
    if combatMods.InstantEquip then
        _cacheOrig(_combatModItem, "EquipCooldown");
        _combatModItem.Info.EquipCooldown = 0;
        if _combatModItem._equip_cooldown then _combatModItem._equip_cooldown = 0 end;
    else
        _restoreOrig(_combatModItem, "EquipCooldown");
    end;
    if combatMods.NoAimSlow then
        _cacheOrig(_combatModItem, "WalkSpeedMultiplier");
        _combatModItem.Info.WalkSpeedMultiplier = 1;
    elseif combatMods.AimSpeedBoost then
        _cacheOrig(_combatModItem, "WalkSpeedMultiplier");
        _combatModItem.Info.WalkSpeedMultiplier = combatMods.AimSpeedBoostMultiplier;
    else
        _restoreOrig(_combatModItem, "WalkSpeedMultiplier");
    end;
    if combatMods.BurstAmount then
        _cacheOrig(_combatModItem, "BurstCount");
        _cacheOrig(_combatModItem, "BurstCooldown");
        _combatModItem.Info.BurstCount = combatMods.BurstCount;
        if type(_combatModItem.Info.BurstCooldown) == "number" then
            _combatModItem.Info.BurstCooldown = math.min(_combatModItem.Info.BurstCooldown or 0, 0.02);
        end;
    else
        _restoreOrig(_combatModItem, "BurstCount");
        _restoreOrig(_combatModItem, "BurstCooldown");
    end;
    if combatMods.RapidFire then
        _cacheOrig(_combatModItem, "ShootCooldown");
        local effectiveRate = math.max(combatMods.RapidFireRate or 0, 0.001);
        _combatModItem.Info.ShootCooldown = effectiveRate;
        if _combatModItem._shoot_cooldown then
            _combatModItem._shoot_cooldown = 0;
        end;
    else
        _restoreOrig(_combatModItem, "ShootCooldown");
        if _combatModItem._shoot_cooldown then
            local origSC = nil;
            pcall(function()
                local id = _combatModItem:Get("ObjectID");
                if _origInfoCache[id] and _origInfoCache[id]["ShootCooldown"] ~= nil then
                    origSC = _origInfoCache[id]["ShootCooldown"];
                end;
            end);
            if origSC ~= nil then
                _combatModItem._shoot_cooldown = origSC;
            end;
        end;
    end;
    if combatMods.ShotAttempts then
        _cacheOrig(_combatModItem, "ShootPellets");
        _combatModItem.Info.ShootPellets = combatMods.ShotAttemptsCount;
        _cacheOrig(_combatModItem, "ShootSpreadConsistent");
        _combatModItem.Info.ShootSpreadConsistent = true;
    else
        _restoreOrig(_combatModItem, "ShootPellets");
        _restoreOrig(_combatModItem, "ShootSpreadConsistent");
    end;
end;
