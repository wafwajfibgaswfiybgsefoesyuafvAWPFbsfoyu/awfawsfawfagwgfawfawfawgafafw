        Callback = function(V)
                _espDummyEnabled = V;
                if not V then
                        for m, _ in pairs(_espDummyTracked) do
                                pcall(function()
                                        ESP.RemoveTarget(m, "Dummy");
                                end);
                        end;
                        _espDummyTracked = {};
                else
                        -- scan immediately on enable so existing dummies show
                        -- up right away instead of on the next periodic pass
                        _espDummyScanForce = true;
                end;
        end;
});

