local RootDesync = {};
RootDesync.__index = RootDesync;

function RootDesync.new(rootPart)
    local self = setmetatable({}, RootDesync);
    self._rootPart = rootPart;
    self._oldCFrame = nil;
    self._cframe = nil;
    self._boundId = game:GetService("HttpService"):GenerateGUID(false);
    game:GetService("RunService"):BindToRenderStep(
        self._boundId,
        Enum.RenderPriority.First.Value,
        function()
            if self._oldCFrame ~= nil then
                pcall(function() self._rootPart.CFrame = self._oldCFrame end);
                self._oldCFrame = nil;
            end;
        end
    );
    return self;
end;

function RootDesync:SetServerCFrame(cf) self._cframe = cf end;
function RootDesync:GetServerCFrame() return self._cframe or self._rootPart.CFrame end;
function RootDesync:GetClientCFrame() return self._oldCFrame or self._rootPart.CFrame end;

RootDesync.HeartbeatUpdate = LPH_NO_VIRTUALIZE(function(self)
    if self._cframe == nil then return end;
    if self._oldCFrame == nil then
        self._oldCFrame = self._rootPart.CFrame;
    end;
    local cam = game:GetService("Workspace").CurrentCamera;
    local savedCamCF = cam and cam.CFrame;
    pcall(function() self._rootPart.CFrame = self._cframe end);
    if cam and savedCamCF then
        pcall(function() cam.CFrame = savedCamCF end);
    end;
end);

RootDesync.RestoreClientCFrame = LPH_NO_VIRTUALIZE(function(self)
    if self._oldCFrame == nil then return end;
    local saved = self._oldCFrame;
    self._oldCFrame = nil;
    pcall(function() self._rootPart.CFrame = saved end);
end);

RootDesync.RestoreClientCFrame = LPH_NO_VIRTUALIZE(function(self)
    if self._oldCFrame ~= nil then
        local saved = self._oldCFrame;
        self._oldCFrame = nil;
        pcall(function() self._rootPart.CFrame = saved end);
    end;
end);

function RootDesync:Destroy()
    pcall(function()
        game:GetService("RunService"):UnbindFromRenderStep(self._boundId);
    end);
    self:RestoreClientCFrame();
    self._cframe = nil;
end;

