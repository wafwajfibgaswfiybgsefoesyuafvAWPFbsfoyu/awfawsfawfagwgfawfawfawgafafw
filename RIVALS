        if config.state.csyncactive then return end;
        -- Don't evade until ragebot has a target locked
        if not config.target.character or not config.target.enabled then return end;
        local now = tick();
        if now - _evadeCooldown < 0.3 then return end;

        local char = LocalPlayer.Character;
        if not char then return end;
        local rp  = char:FindFirstChild("HumanoidRootPart");
        local hum = char:FindFirstChildOfClass("Humanoid");
        if not rp or not hum or hum.Health <= 0 then return end;

        local minDist = config.evade.minDist or 6;
        local maxDist = config.evade.maxDist or 14;

        -- perf: use cached PlayersService instead of game:GetService every frame
        for _, player in ipairs(PlayersService:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and not isteammate(player) then
                local enemyRoot = player.Character:FindFirstChild("HumanoidRootPart");
                if enemyRoot then
                    local dist = (rp.Position - enemyRoot.Position).Magnitude;
                    if dist <= minDist then
                        _evadeCooldown = now;
                        local awayDir = rp.Position - enemyRoot.Position;
                        if awayDir.Magnitude < 0.01 then
                            awayDir = Vector3.new(1, 0, 0);
                        else
                            awayDir = Vector3.new(awayDir.X, 0, awayDir.Z); -- flatten to XZ
                            if awayDir.Magnitude < 0.01 then
                                awayDir = Vector3.new(1, 0, 0);
                            else
                                awayDir = awayDir.Unit;
                            end;
                        end;
                        local targetPos = rp.Position + awayDir * maxDist;
                        -- Use Humanoid:MoveTo so the character walks/slides away
                        -- rather than raw-CFrame snapping (avoids physics desync)
                        pcall(function() hum:MoveTo(targetPos) end);
                        break;
                    end;
                end;
            end;
        end;
    end));
end;

