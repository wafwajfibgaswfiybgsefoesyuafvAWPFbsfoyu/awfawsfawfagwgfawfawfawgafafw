    function EnsureBackup(Name, Model)
        if not (BackupFolder and Model) then return nil end;
        if BackupFolder:FindFirstChild(Name) then
            return BackupFolder:FindFirstChild(Name);
        end;
        local Folder = Instance.new("Folder");
        Folder.Name = Name;
        for _, Child in ipairs(Model:GetChildren()) do
            local Clone = Child:Clone();
            if Clone then Clone.Parent = Folder end;
        end;
        Folder.Parent = BackupFolder;
        return Folder;
    end;

    function ReplaceChildren(Target, Source)
        if not (Target and Source) then return 0 end;
        Target:ClearAllChildren();
        local Count = 0;
        for _, Child in ipairs(Source:GetChildren()) do
            local Clone = Child:Clone();
            if Clone then
                Clone.Parent = Target;
                Count = Count + 1;
            end;
        end;
        return Count;
    end;

    function RestoreFromBackup(BackupName, Target)
        if not (BackupFolder and Target) then return false end;
        local Backup = BackupFolder:FindFirstChild(BackupName);
        if not Backup then return false end;
        ReplaceChildren(Target, Backup);
        return true;
    end;

