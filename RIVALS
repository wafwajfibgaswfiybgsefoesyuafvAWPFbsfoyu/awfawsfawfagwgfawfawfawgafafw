        local _fpsPingThread = nil
        local _fpsPingConn   = nil
        local function startFpsPingSpoof()
            if _fpsPingThread then return end
            local fps, ping
            local lastPick = 0
            local _lastLabelSearch = 0
            local function pickNewValues()
                local fMin = tonumber(Library.Flags["FpsRangeMin"]) or 60
                local fMax = tonumber(Library.Flags["FpsRangeMax"]) or 120
                local pMin = tonumber(Library.Flags["PingRangeMin"]) or 20
                local pMax = tonumber(Library.Flags["PingRangeMax"]) or 60
                if fMin > fMax then fMin, fMax = fMax, fMin end
                if pMin > pMax then pMin, pMax = pMax, pMin end
                fps  = math.random(fMin, fMax)
                ping = math.random(pMin, pMax)
            end
