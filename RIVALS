    do
    function FindModel(Root, Name)
        if not (Root and Name) then return nil end;

        local d = Root:FindFirstChild(Name);
        if d then return d end;

        local ln = string.lower(Name);
        for _, c in ipairs(Root:GetChildren()) do
            if string.lower(c.Name) == ln then return c end;
        end

        for _, c in ipairs(Root:GetDescendants()) do
            if string.lower(c.Name) == ln then return c end;
        end

        local hyp = string.gsub(Name, "%-", " ");
        local spc = string.gsub(Name, " ", "%-");
        for _, variant in ipairs({ hyp, spc }) do
            local lv = string.lower(variant);
            for _, c in ipairs(Root:GetDescendants()) do
                if string.lower(c.Name) == lv then return c end;
            end
        end

        local short = ln;
        if #short >= 3 then
            for _, c in ipairs(Root:GetDescendants()) do
                if string.sub(string.lower(c.Name), 1, #short) == short then
                    return c;
                end;
            end;
        end;

        return nil;
    end;

    local function ExtractHowTo(Info)
        local HowTo = Info.HowToGet or Info.Source or Info.Method
                   or Info.ObtainMethod or Info.Crate or Info.Box
                   or Info.Origin or Info.Collection or Info.Set
                   or Info.Drop or Info.Limited
                   or Info.HowToObtain or Info.Acquisition
                   or Info.Season or Info.Event
                   or Info.Case or Info.BattlePass
                   or Info.Bundle or Info.Pack or Info.Tier
                   or Info.Unlock or Info.Requirement
                   or Info.Quest or Info.Series or Info.SkinSet
                   or Info.Theme or Info.Line or Info.Family
                   or Info.Group or Info.Category or Info.Tag
                   or Info.Flair or Info.Edition or Info.Release
                   or Info.Update or Info.WeaponCase or "";
        if typeof(HowTo) ~= "string" then HowTo = tostring(HowTo) end;
        if HowTo == "" then
            if typeof(Info.Tags) == "table" then
                local tags = {};
                for _, t in pairs(Info.Tags) do
                    if type(t) == "string" then table.insert(tags, t) end;
                end;
                HowTo = table.concat(tags, ", ");
            elseif typeof(Info.Sources) == "table" then
                local srcs = {};
                for _, t in pairs(Info.Sources) do
                    if type(t) == "string" then table.insert(srcs, t) end;
                end;
                HowTo = table.concat(srcs, ", ");
            end;
        end;
        local Desc = Info.Description or Info.DescriptionSpecific or "";
        if HowTo == "" and Desc ~= "" then HowTo = Desc end;
        if HowTo == "" then
            local rar = (Info.Rarity and tostring(Info.Rarity)) or "common";
            HowTo = string.lower(rar) .. " — check crates / market";
        end;
        return HowTo, Desc;
    end;

    local function NormalizeImage(Img)
        if not Img or Img == "" then return "" end;
        if string.sub(Img, 1, 13) ~= "rbxassetid://" and tonumber(Img) then
            Img = "rbxassetid://" .. Img;
        end;
        return Img;
    end;

    function ReindexSkins()
        WeaponSkins     = {};
        WeaponWraps     = {};
        WeaponCharms    = {};
        WeaponFinishers = {};
        RarityColors    = {};
        WeaponIconOf    = {};
        SkinIconOf      = {};
        WrapIconOf      = {};
        CharmIconOf     = {};
        FinisherIconOf  = {};
        SkinInfoOf      = {};
        WrapInfoOf      = {};
        CharmInfoOf     = {};
        FinisherInfoOf  = {};
        if not CosmeticLib or not CosmeticLib.Cosmetics then return end;

        if CosmeticLib.Rarities then
            for RName, RData in pairs(CosmeticLib.Rarities) do
                if typeof(RData) == "table" and RData.Color then
                    if typeof(RData.Color) == "Color3" then
                        RarityColors[RName] = RData.Color;
                    elseif typeof(RData.Color) == "string" then
                        local Ok, C = pcall(Color3.fromHex, RData.Color);
                        if Ok then RarityColors[RName] = C end;
                    end;
                end;
            end;
        end;

        local seen = {};
        local firstSkinDumped, firstWrapDumped, firstCharmDumped, firstFinisherDumped = false, false, false, false;
        local function DumpEntry(label, name, weapon, info)
            for k, v in pairs(info) do
                local vs = tostring(v);
                if #vs > 80 then vs = string.sub(vs, 1, 80) .. "..." end;
            end;
        end;

        for CosmeticName, Info in pairs(CosmeticLib.Cosmetics) do
            if typeof(Info) == "table" then
                local Kind = Info.Type;
                local Img  = NormalizeImage(Info.ImageHighResolution or Info.Image or "");
                local HowTo, Desc = ExtractHowTo(Info);
                local Rar  = Info.Rarity or "Common";

                if Kind == "Skin" then
                    local Weapon = Info.ItemName or Info.ForWeapon or Info.Weapon;
                    if Weapon and Weapon ~= "" and CosmeticName ~= Weapon then
                        if not WeaponSkins[Weapon] then
                            WeaponSkins[Weapon] = {};
                            seen[Weapon] = true;
                        end;
                        table.insert(WeaponSkins[Weapon], {
                            name = CosmeticName; rarity = Rar;
                            image = Img; desc = Desc; howto = HowTo;
                        });
                        if Img ~= "" then SkinIconOf[CosmeticName] = Img end;
                        SkinInfoOf[CosmeticName] = {
                            desc = Desc; howto = HowTo;
                            rarity = Rar; image = Img;
                        };
                        if not firstSkinDumped then
                            firstSkinDumped = true;
                            DumpEntry("SKIN", CosmeticName, Weapon, Info);
                        end;
                    end;

                elseif Kind == "Wrap" then
                    local Weapon = Info.ItemName or Info.ForWeapon or Info.Weapon;
                    if Weapon and Weapon ~= "" then
                        if not WeaponWraps[Weapon] then
                            WeaponWraps[Weapon] = {};
                        end;
                        table.insert(WeaponWraps[Weapon], {
                            name = CosmeticName; rarity = Rar;
                            image = Img; desc = Desc; howto = HowTo;
                        });
                    else
                        if not WeaponWraps["__universal__"] then
                            WeaponWraps["__universal__"] = {};
                        end;
                        table.insert(WeaponWraps["__universal__"], {
                            name = CosmeticName; rarity = Rar;
                            image = Img; desc = Desc; howto = HowTo;
                        });
                    end;
                    if Img ~= "" then WrapIconOf[CosmeticName] = Img end;
                    WrapInfoOf[CosmeticName] = {
                        desc = Desc; howto = HowTo;
                        rarity = Rar; image = Img;
                    };
                    if not firstWrapDumped then
                        firstWrapDumped = true;
                        DumpEntry("WRAP", CosmeticName, Weapon or "universal", Info);
                    end;

                elseif Kind == "Charm" or Kind == "CharmSkin" then
                    table.insert(WeaponCharms, {
                        name = CosmeticName; rarity = Rar;
                        image = Img; desc = Desc; howto = HowTo;
                    });
                    if Img ~= "" then CharmIconOf[CosmeticName] = Img end;
                    CharmInfoOf[CosmeticName] = {
                        desc = Desc; howto = HowTo;
                        rarity = Rar; image = Img;
                    };
                    if not firstCharmDumped then
                        firstCharmDumped = true;
                        DumpEntry("CHARM", CosmeticName, "universal", Info);
                    end;

                elseif Kind == "Finisher" or Kind == "FinisherSkin" or Kind == "Execution" then
                    local Anim = Info.AnimationId or Info.Animation or Info.FinisherAnim
                              or Info.ExecutionAnim or Info.KillAnim or Info.AnimId or "";
                    if typeof(Anim) ~= "string" then Anim = tostring(Anim) end;
                    local ModelRef = Info.Model or Info.FinisherModel or Info.PreviewModel or nil;

                    table.insert(WeaponFinishers, {
                        name = CosmeticName; rarity = Rar;
                        image = Img; desc = Desc; howto = HowTo;
                        anim = Anim; model = ModelRef;
                    });
                    if Img ~= "" then FinisherIconOf[CosmeticName] = Img end;
                    FinisherInfoOf[CosmeticName] = {
                        desc = Desc; howto = HowTo;
                        rarity = Rar; image = Img;
                        anim = Anim; model = ModelRef;
                    };
                    if not firstFinisherDumped then
                        firstFinisherDumped = true;
                        DumpEntry("FINISHER", CosmeticName, "universal", Info);
                    end;
                end;
            end;
        end;

        local uniWraps = WeaponWraps["__universal__"] or {};
        for Weapon, _ in pairs(seen) do
            if not WeaponWraps[Weapon] then WeaponWraps[Weapon] = {} end;
            for _, w in ipairs(uniWraps) do
                table.insert(WeaponWraps[Weapon], w);
            end;
        end;
        WeaponWraps["__universal__"] = nil;

        for Weapon, _ in pairs(seen) do
            local Img = nil;
            local W = CosmeticLib.Cosmetics and CosmeticLib.Cosmetics[Weapon];
            if W and typeof(W) == "table" then
                Img = W.ImageHighResolution or W.Image or W.Icon or W.TextureId or W.ImageId;
            end;
            if not Img and ItemLib then
                if ItemLib.Items and ItemLib.Items[Weapon] then
                    local I = ItemLib.Items[Weapon];
                    Img = I.Image or I.Icon or I.ImageHighResolution
                       or I.TextureId or I.ImageId or I.Thumbnail;
                end;
                if not Img and ItemLib.ViewModels and ItemLib.ViewModels[Weapon] then
                    local V = ItemLib.ViewModels[Weapon];
                    Img = V.Image or V.Icon or V.TextureId or V.ImageId;
                end;
            end;
            if not Img and ModelAssets then
                local model = FindModel(ModelAssets, Weapon);
                if model then
                    for _, desc in ipairs(model:GetDescendants()) do
                        if desc:IsA("MeshPart") and desc.TextureID and desc.TextureID ~= "" then
                            Img = desc.TextureID; break;
                        elseif desc:IsA("SpecialMesh") and desc.TextureId and desc.TextureId ~= "" then
                            Img = desc.TextureId; break;
                        end;
                    end;
                end;
            end;
            if Img then
                WeaponIconOf[Weapon] = NormalizeImage(Img);
            end;
        end;

        local list = {};
        for w in pairs(seen) do table.insert(list, w) end;
        table.sort(list, function(a, b) return string.lower(a) < string.lower(b) end);
        WeaponOrder = list;

        for _, L in pairs(WeaponSkins) do
            table.sort(L, function(a, b) return string.lower(a.name) < string.lower(b.name) end);
        end;
        for _, L in pairs(WeaponWraps) do
            table.sort(L, function(a, b) return string.lower(a.name) < string.lower(b.name) end);
        end;
        table.sort(WeaponCharms, function(a, b) return string.lower(a.name) < string.lower(b.name) end);
        table.sort(WeaponFinishers, function(a, b) return string.lower(a.name) < string.lower(b.name) end);
    end;

