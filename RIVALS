local function nearest()
    local sortMode = config.target.targetSort or "nearest";
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart");
    local myPos = myRoot and myRoot.Position or Vector3.zero;
    local candidates = {};
    local priority = {};
    for _, targetplayer in ipairs(PlayersService:GetPlayers()) do
        if targetplayer == LocalPlayer then continue end;
        if isteammate(targetplayer) then continue end;
        if not isInLocalMatch(targetplayer) then continue end;
        local char = targetplayer.Character;
        if not char or not valid(char) then continue end;
        local root = char:FindFirstChild("HumanoidRootPart");
        if not root then continue end;
        local dist = (root.Position - myPos).Magnitude;
        if config.target.maxDistance > 0 and dist > config.target.maxDistance then continue end;
        local hum = char:FindFirstChildOfClass("Humanoid");
        local hp = hum and hum.Health or 0;
        local isPriority = false;
        if config.prioritize.enabled then
            if config.prioritize.players[targetplayer.Name] then isPriority = true end;
            if config.prioritize.exploiters and isExploiter(targetplayer) then isPriority = true end;
        end;
        if isPriority then
            table.insert(priority, { char = char, root = root, dist = dist, hp = hp, player = targetplayer });
        end;
        table.insert(candidates, { char = char, root = root, dist = dist, hp = hp, player = targetplayer });
    end;
    local pool = (#priority > 0) and priority or candidates;
    if #pool == 0 then return nil end;
    if sortMode == "farthest" then
        local best, bestDist = nil, -1;
        for _, c in ipairs(pool) do if c.dist > bestDist then best = c; bestDist = c.dist; end; end;
        return best and best.char;
    elseif sortMode == "lowest hp" then
        local best, bestHp = nil, math.huge;
        for _, c in ipairs(pool) do if c.hp < bestHp then best = c; bestHp = c.hp; end; end;
        return best and best.char;
    elseif sortMode == "highest hp" then
        local best, bestHp = nil, -1;
        for _, c in ipairs(pool) do if c.hp > bestHp then best = c; bestHp = c.hp; end; end;
        return best and best.char;
    elseif sortMode == "random" then
        return pool[math.random(1, #pool)].char;
    end;
    local best, bestDist = nil, math.huge;
    for _, c in ipairs(pool) do if c.dist < bestDist then best = c; bestDist = c.dist; end; end;
    return best and best.char;
end;

-- ── Meow-style ping-aware weighted predictor ──────────────────────────────
local _pred_track = {};
local _TT_HISTORY_LEN = 128;
local _TT_VEL_EMA_FAST = 0.25;
local _TT_VEL_EMA_SLOW = 0.08;
local _TT_CHAOS_JUMP = 400;
local _TT_CHAOS_THRESH = 4;
local _TT_VOID_Y = -200;
local _TT_MAX_EXTRAP = 0.4;

local function _tt_valid(x,y,z)
    return x==x and y==y and z==z and math.abs(x)~=math.huge and math.abs(y)~=math.huge and math.abs(z)~=math.huge;
end;

local function _tt_get_ping()
    local ok, stat = pcall(function() return game:GetService("Stats") end);
    if ok and stat then
        local ok2, ping = pcall(function() return stat.Network.ServerStatsItem["Data Ping"].Value end);
        if ok2 and type(ping)=="number" and ping==ping then
            return math.clamp(ping/1000, 0, 0.5);
        end;
    end;
    return 1/30;
end;

local function _tt_record(part, now)
    local pos;
    pcall(function() pos = part.Position end);
    if not pos then return end;
    local x,y,z = pos.X, pos.Y, pos.Z;
    if not _tt_valid(x,y,z) then return end;

    local live = _pred_track[part];
    if not live then
        _pred_track[part] = {
            x=x,y=y,z=z,t=now,
            lkg_x=x,lkg_y=y,lkg_z=z,lkg_t=now,
            vel_ema_x=0,vel_ema_y=0,vel_ema_z=0,
            spd_ema_fast=0,spd_ema_slow=0,
            chaos_count=0,is_void=false,
            hist={},hi=0,
        };
        return;
    end;

    local px,py,pz,pt = live.x,live.y,live.z,live.t;
    local dt = now - pt;
    live.x,live.y,live.z,live.t = x,y,z,now;

    if dt > 0.000001 then
        local jump = math.sqrt((x-px)^2+(y-py)^2+(z-pz)^2);
        local spd = jump/dt;
        live.spd_ema_fast = live.spd_ema_fast*(1-_TT_VEL_EMA_FAST) + spd*_TT_VEL_EMA_FAST;
        live.spd_ema_slow = live.spd_ema_slow*(1-_TT_VEL_EMA_SLOW) + spd*_TT_VEL_EMA_SLOW;
        local rvx,rvy,rvz = (x-px)/dt,(y-py)/dt,(z-pz)/dt;
        live.vel_ema_x = live.vel_ema_x*0.7 + rvx*0.3;
        live.vel_ema_y = live.vel_ema_y*0.7 + rvy*0.3;
        live.vel_ema_z = live.vel_ema_z*0.7 + rvz*0.3;
        if jump > _TT_CHAOS_JUMP then
            live.chaos_count = (live.chaos_count or 0) + 3;
        else
            local cc = live.chaos_count or 0;
            if cc > 0 then live.chaos_count = cc - 1; end;
        end;
    end;

    if y >= _TT_VOID_Y then
        live.lkg_x,live.lkg_y,live.lkg_z,live.lkg_t = x,y,z,now;
        live.is_void = false;
    else
        live.is_void = true;
    end;

    local hist = live.hist;
    local hi = (live.hi % _TT_HISTORY_LEN) + 1;
    live.hi = hi;
    hist[hi] = {x=x,y=y,z=z,t=now};
end;

local function _tt_predict_vel(live, hist, hi)
    local vx,vy,vz,tw = 0,0,0,0;
    local count = math.min(#hist, 24);
    for k=1, count-1 do
        local bi = ((hi-k-1+_TT_HISTORY_LEN) % _TT_HISTORY_LEN)+1;
        local ai = ((hi-k-2+_TT_HISTORY_LEN) % _TT_HISTORY_LEN)+1;
        local b,a = hist[bi],hist[ai];
        if b and a then
            local dth = b.t - a.t;
            if dth > 0.000001 then
                local dvx,dvy,dvz = (b.x-a.x)/dth,(b.y-a.y)/dth,(b.z-a.z)/dth;
                if dvx*dvx+dvy*dvy+dvz*dvz < 1e12 then
                    local w = 1/(k*k);
                    vx=vx+dvx*w; vy=vy+dvy*w; vz=vz+dvz*w; tw=tw+w;
                end;
            end;
        end;
    end;
    if tw == 0 then return Vector3.zero end;
    return Vector3.new(vx/tw, vy/tw, vz/tw);
end;



local function predict(hitPart, origin)
    if not config.prediction.enabled then return hitPart.Position end;
    local now = tick();
    _tt_record(hitPart, now);
    local live = _pred_track[hitPart];
    if not live then return hitPart.Position end;

    local ping = _tt_get_ping();
    local mult = config.prediction.multiplier or 1.2;

    -- If the enemy is voidspamming/chaotic, try void mimic first, then fall back to lkg
    if live.is_void or (live.chaos_count or 0) >= _TT_CHAOS_THRESH then
        if live.lkg_x and _tt_valid(live.lkg_x,live.lkg_y,live.lkg_z) then
            return Vector3.new(live.lkg_x,live.lkg_y,live.lkg_z);
        end;
        return hitPart.Position;
    end;

    local vel = _tt_predict_vel(live, live.hist, live.hi);
    local spd = vel.Magnitude;
    local base = hitPart.Position;

    if spd > 0.01 then
        local la = math.min(spd/1000*ping*mult, _TT_MAX_EXTRAP);
        local pred = base + vel*la;
        -- Adaptive: only use prediction if it's closer to lkg than raw position
        if live.lkg_x then
            local lkg = Vector3.new(live.lkg_x,live.lkg_y,live.lkg_z);
            if (pred-lkg).Magnitude < (base-lkg).Magnitude then
                return pred;
            end;
        else
            return pred;
        end;
    end;

    return base;
end;

