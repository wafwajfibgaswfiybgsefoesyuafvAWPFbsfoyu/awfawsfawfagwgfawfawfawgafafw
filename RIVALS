local function tickAmmo()
    local lf = modules.fighter and modules.fighter.LocalFighter;
    if not lf or not lf.EquippedItem then
        config.state.reloading = false;
        config.state.outofammo = false;
        return;
    end;
    local item = lf.EquippedItem;
    local current = 0;
    pcall(function() current = item:Get("CurrentAmmo") or item:Get("Ammo") or 0 end);
    if isInfiniteWeapon() then
        config.state.outofammo = false;
        config.state.reloading = false;
        return;
    end;
    local _, _, melee = getammo();
    if melee then
                    startMeleeBypass();
        config.state.outofammo = false;
        config.state.reloading = false;
        return;
    end;
    local isEmpty = (tonumber(current) or 0) <= 0;
    config.state.outofammo = isEmpty;
    config.state.reloading = false;
    -- Auto-reload directly in the ragebot loop: as soon as ammo hits 0 while
    -- ragebot is active, trigger a reload immediately instead of waiting for
    -- the separate misc auto-reload to catch it on its next pass.
    if isEmpty and config.target.enabled then
        local _reloadItem = lf and lf.EquippedItem;
        if _reloadItem then
            pcall(function()
                if _reloadItem.Input then
                    _reloadItem:Input("StartReloading");
                elseif _reloadItem.StartReloading then
                    _reloadItem:StartReloading();
                end;
            end);
        end;
    end;
end;

local function tickImmunity()
    if config.target.lastplayer then
        local wasImmune = config.target.immune;
        config.target.immune = isImmune(config.target.lastplayer);
        if wasImmune and not config.target.immune then
            if config.target.enabled and config.target.character and valid(config.target.character) then
                if not config.state.csyncactive then startsync(); end;
            end;
        elseif not wasImmune and config.target.immune then
            if config.state.csyncactive then stopsync(); end;
        end;
    end;
end;

