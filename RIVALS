                -- Hide character
                for _, part in pairs(char:GetDescendants()) do
                    if (part:IsA("BasePart") or part:IsA("Decal")) and part.Name ~= "HumanoidRootPart" then
                        part.LocalTransparencyModifier = 1
                    end
                end

                -- Use the same offset sliders as third person
                local dist  = Library.Flags["ThirdPersonDistance"] or 7.5
                local right = Library.Flags["ThirdPersonRight"]    or 3
                local offsetX = right  -- positive = right
                local offsetY = 1.5
                local offsetZ = dist

                local cf = camera.CFrame
                local offset = Vector3.new(offsetX, offsetY, offsetZ)

                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = { char }
                local worldOffset = cf:VectorToWorldSpace(offset)
                local raycast = workspace:Raycast(cf.Position, worldOffset, params)
                if raycast then
                    local localHit = cf:VectorToObjectSpace(raycast.Position - cf.Position)
                    local mag = localHit.Magnitude
                    if mag > 0.2 then
                        offset = localHit.Unit * (mag - 0.2)
                    else
                        offset = Vector3.zero
                    end
                end

                camera.CameraType = Enum.CameraType.Track
                camera.CFrame = cf * CFrame.new(offset)
            end))
