        };

        local GroupId    = 3461453;
        local MinRank    = 100;
        local ROLE_TTL   = 300;
        local RETRY_WAIT = 15;

        local function _mdNotify(text)
            pcall(function() Library:Notify("Mod Detector: " .. text, 8) end);
        end;

        local function _mdIsRunning()
            return _mdState.enabled and not _mdState.unloaded;
        end;

        local function _mdIsStaff(player)
            if not player or player == LocalPlayer then return false end;
            local cached = _mdState.roleCache[player.UserId];
            if cached and cached.exp > os.clock() then return cached.val end;
            local ok, rank = pcall(function()
                return player:GetRankInGroup(GroupId);
            end);
            if not ok or type(rank) ~= "number" then return nil end;
            local result = rank >= MinRank;
            _mdState.roleCache[player.UserId] = { val = result, exp = os.clock() + ROLE_TTL };
            return result;
        end;

        local function _mdRunAction(player)
            if not _mdIsRunning() or not player then return end;
            if _mdState.action == "leave" then
                if not _mdState.detections[player.UserId .. "_kicked"] then
                    _mdState.detections[player.UserId .. "_kicked"] = true;
                    pcall(function()
                        Players.LocalPlayer:Kick("mod has been detected");
                    end);
                end;
            else
                if not _mdState.detections[player.UserId .. "_notified"] then
                    _mdState.detections[player.UserId .. "_notified"] = true;
                    _mdNotify(player.Name .. " is a RIVALS moderator");
                end;
            end;
        end;

        local _mdQueue;
        _mdQueue = function(player, delay)
            if not _mdIsRunning() or not player or player == LocalPlayer then return end;
            local uid = player.UserId;
            local rgen = ((_mdState.retryGen[uid] or 0) + 1);
            _mdState.retryGen[uid] = rgen;
            local dgen = _mdState.generation;
            task.delay(delay or 0, function()
                if not _mdIsRunning()
                    or dgen ~= _mdState.generation
                    or rgen ~= _mdState.retryGen[uid]
                    or player.Parent ~= Players
                    or _mdState.inFlight[uid] then return end;
                _mdState.inFlight[uid] = true;
                local result = _mdIsStaff(player);
                _mdState.inFlight[uid] = nil;
                if not _mdIsRunning()
                    or dgen ~= _mdState.generation
                    or rgen ~= _mdState.retryGen[uid]
                    or player.Parent ~= Players then return end;
                if result == true then
                    _mdState.detections[uid] = true;
                    _mdRunAction(player);
                elseif result == nil then
                    _mdQueue(player, RETRY_WAIT);
                end;
            end);
        end;

        local function _mdStart()
            for _, c in ipairs(_mdState.connections) do pcall(function() c:Disconnect() end) end;
            _mdState.connections = {};
            _mdState.generation  = _mdState.generation + 1;
            _mdState.detections  = {};
            table.insert(_mdState.connections, Players.PlayerAdded:Connect(function(p)
                _mdQueue(p, 0);
            end));
            table.insert(_mdState.connections, Players.PlayerRemoving:Connect(function(p)
                local uid = p.UserId;
                _mdState.detections[uid]  = nil;
                _mdState.retryGen[uid]    = nil;
                _mdState.inFlight[uid]    = nil;
            end));
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then _mdQueue(p, 0) end;
            end;
        end;

        local function _mdStop()
            _mdState.enabled = false;
            _mdState.generation = _mdState.generation + 1;
            for _, c in ipairs(_mdState.connections) do pcall(function() c:Disconnect() end) end;
            _mdState.connections = {};
            _mdState.detections  = {};
        end;

