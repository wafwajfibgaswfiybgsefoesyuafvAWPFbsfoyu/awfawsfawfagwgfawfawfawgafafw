    MakeWrapViewport = function(parent, wrapName)
        if not parent or not CosmeticLib then return end;
        local vf = Instance.new("ViewportFrame");
        vf.Size = UDim2.new(1, 0, 1, 0);
        vf.BackgroundTransparency = 1;
        vf.LightDirection = Vector3.new(-1, -1, -1);
        vf.LightColor = Color3.new(1, 1, 1);
        vf.Ambient = Color3.fromRGB(200, 200, 200);
        vf.ZIndex = (parent.ZIndex or 1) + 1;
        vf.Parent = parent;

        local cam = Instance.new("Camera");
        cam.FieldOfView = 35;
        vf.CurrentCamera = cam;
        cam.Parent = vf;

        local enterConn, leaveConn, spinConn;
        local wrapModel;
        local function cleanup()
            if enterConn then enterConn:Disconnect(); enterConn = nil; end;
            if leaveConn then leaveConn:Disconnect(); leaveConn = nil; end;
            if spinConn  then spinConn:Disconnect();  spinConn  = nil; end;
        end;
        ViewportCleanups[parent] = cleanup;

        task.spawn(function()
            pcall(function()
                local ps = LocalPlayer:WaitForChild("PlayerScripts");
                local cosData = CosmeticLib.Cosmetics and CosmeticLib.Cosmetics[wrapName];
                if not cosData or not cosData.WrapGroups then return end;
                local wrapTemplate = ps:FindFirstChild("Assets")
                    and ps.Assets:FindFirstChild("Misc")
                    and ps.Assets.Misc:FindFirstChild("Wrap");
                if not wrapTemplate then return end;
                wrapModel = wrapTemplate:Clone();
                wrapModel.Parent = vf;
                local meshParts = {};
                for _, p in ipairs(wrapModel:GetChildren()) do
                    if p:IsA("BasePart") then table.insert(meshParts, p) end;
                end;
                for i, wg in ipairs(cosData.WrapGroups) do
                    local part = meshParts[i];
                    if part then
                        if wg.Color then part.Color = wg.Color end;
                        if wg.Material then pcall(function() part.Material = wg.Material end) end;
                        if wg.Transparency then part.Transparency = wg.Transparency end;
                        if wg.Reflectance then part.Reflectance = wg.Reflectance end;
                        if wg.MaterialVariant and wg.MaterialVariant ~= "" then
                            pcall(function() part.MaterialVariant = wg.MaterialVariant end);
                        end;
                    end;
                end;
                local cf0, size0 = wrapModel:GetBoundingBox();
                local maxDim = math.max(size0.X, size0.Y, size0.Z);
                local dist = math.max(maxDim * 2.2, 2.0);
                local offset = Vector3.new(dist * 0.05, dist * 0.4, dist * 1.1);
                cam.CFrame = CFrame.new(cf0.Position + offset, cf0.Position);
            end);
        end);
        return vf;
    end;

