                if A == B then return true end;
                if not A or not B then return false end;
                for K, V in pairs(A) do if A[K] ~= B[K] then return false end end;
                for K, V in pairs(B) do if A[K] ~= B[K] then return false end end;
                return true;
        end;

        local function SwitchToMap(NewMap)
                if CurrentMap == NewMap then return end;
                MapProfiles[CurrentMap] = CaptureProfile();
                if CurrentMap == "All" and AllProfileOnEntry then
                        local CurrentAll = MapProfiles["All"];
                        if not ProfilesEqual(AllProfileOnEntry, CurrentAll) then
                                for K, _ in pairs(MapProfiles) do
                                        if K ~= "All" then
                                                MapProfiles[K] = DeepCopyProfile(CurrentAll);
                                        end;
                                end;
                        end;
                end;
                CurrentMap = NewMap;
                if NewMap == "All" then
                        AllProfileOnEntry = DeepCopyProfile(MapProfiles["All"] or MakeDefaultProfile());
                else
                        AllProfileOnEntry = nil;
                end;
                local Prof = MapProfiles[NewMap] or MapProfiles["All"] or MakeDefaultProfile();
