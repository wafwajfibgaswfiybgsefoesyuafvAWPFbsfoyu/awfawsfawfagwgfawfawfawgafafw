    function PlayerHelper.GetKillfeedIcon(weaponName)
        if not weaponName or weaponName == "" then return nil, nil end;

        local lib = _GetItemLibrary();
        if lib and lib.ViewModels then
            local vm = lib.ViewModels[weaponName];
            if vm and vm.EliminationFeedImage then
                return vm.EliminationFeedImage, vm.EliminationFeedImageScale or 1;
            end;
            if lib.Items and lib.Items[weaponName] then
                local baseName = nil;
                pcall(function() baseName = lib.Items[weaponName].Base end);
                if baseName and lib.ViewModels[baseName] and lib.ViewModels[baseName].EliminationFeedImage then
                    return lib.ViewModels[baseName].EliminationFeedImage, lib.ViewModels[baseName].EliminationFeedImageScale or 1;
                end;
            end;
        end;

        local hit = _KillfeedIconFallback[weaponName];
        if hit then return hit.Id, hit.Scale end;

        local lower = string.lower(weaponName):gsub("%s", "");
        for _, hint in ipairs(_SkinBaseHints) do
            if string.find(lower, hint.Pattern, 1, true) then
                local b = _KillfeedIconFallback[hint.Base];
                if b then return b.Id, b.Scale end;
            end;
        end;

        local missing = _KillfeedIconFallback["MISSING_WEAPON"];
        if missing then return missing.Id, missing.Scale end;
        return nil, nil;
    end
end

local ESPMatchCache = { cache = {}, lastScan = 0 }

local ESPScanMatch = LPH_NO_VIRTUALIZE(function()
    local out = {}
    pcall(function()
        local lp = Client
        if not lp then return end

        local okFC, fc = pcall(function()
            return require(lp:WaitForChild("PlayerScripts"):WaitForChild("Controllers"):WaitForChild("FighterController"))
        end)
        if not okFC or not fc then return end

        local lf = fc.LocalFighter
        if not lf then return end

        local lfd = rawget(lf, "Data")
        if not lfd then return end
        if not rawget(lfd, "IsInDuel") then return end

        local myEnv = rawget(lfd, "EnvironmentID")

        local playerMap = fc._player_to_fighter
        if type(playerMap) ~= "table" then return end

        for player, fighter in pairs(playerMap) do
            if player ~= lp then
                local d = rawget(fighter, "Data")
                if d and rawget(d, "IsInDuel") and rawget(d, "EnvironmentID") == myEnv then
                    out[player.Name] = true
                end
            end
        end
    end)
    ESPMatchCache.cache = out
end)

local ESPGetMatch = LPH_NO_VIRTUALIZE(function()
    local now = os_clock()
    if now - ESPMatchCache.lastScan < 1 then return ESPMatchCache.cache end
    ESPMatchCache.lastScan = now
    ESPScanMatch()
    return ESPMatchCache.cache
end)

