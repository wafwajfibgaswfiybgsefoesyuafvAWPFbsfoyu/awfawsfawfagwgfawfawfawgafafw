            part.Color    = _vmMatConfig.color
            for _, tx in pairs(part:GetChildren()) do
                if tx:IsA("Texture") or tx:IsA("Decal") then
                    tx.Transparency = 1
                elseif tx:IsA("SurfaceAppearance") then
                    if tx.Parent ~= nil then
                        tx:SetAttribute("_matOrigParent", tx.Parent)
                        tx.Parent = nil
