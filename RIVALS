do
    local _gfEnv = getgenv()
    if _gfEnv.__InputHookCleanup then pcall(_gfEnv.__InputHookCleanup) end

    local _gfToken = {}
    _gfEnv.__InputHookToken = _gfToken

    local _gfCONFIG = {
        NoSpread    = false,
        GrenadeFuse = false,
        ExplodeOn   = "Impact",
        RemoveFuse  = false,
        RetryInterval = 1,
    }

    local _gfHook = { handlers = {}, restore = nil, installed = false }

    local function _gfReport(where, err) warn(("[GF Hook] %s: %s"):format(where, tostring(err))) end

    local function _gfPlayerModules()
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        return ps and ps:FindFirstChild("Modules"), ps and ps:FindFirstChild("Controllers")
    end

    local function _gfResolveClientItem()
        local modules = _gfPlayerModules()
        local rep = modules and modules:FindFirstChild("ClientReplicatedClasses")
        local fi  = rep and rep:FindFirstChild("ClientFighter")
        local ci  = fi and fi:FindFirstChild("ClientItem")
        if not ci then return nil end
        local ok, r = pcall(require, ci)
        return (ok and type(r) == "table") and r or nil
    end

    local function _gfResolveRemote()
        local r = ReplicatedStorage:FindFirstChild("Remotes")
        r = r and r:FindFirstChild("Replication")
        r = r and r:FindFirstChild("Fighter")
        r = r and r:FindFirstChild("UseItem")
        if not r or not r:IsA("RemoteEvent") then return nil end
        return (type(cloneref) == "function" and cloneref(r)) or r
    end

    local function _gfResolveDecoder()
        local m = ReplicatedStorage:FindFirstChild("Modules")
        local lib = m and m:FindFirstChild("EnumLibrary")
        if not lib then return nil end
        local ok, r = pcall(require, lib)
        if not ok or type(r) ~= "table" then return nil end
        local fe = rawget(r, "_from_enum")
        if type(fe) ~= "table" then return nil end
        return function(e) return rawget(fe, e) end
    end

    local function _gfResolveThrowable()
        local modules = _gfPlayerModules()
        local it = modules and modules:FindFirstChild("ItemTypes")
        local t  = it and it:FindFirstChild("Throwable")
        if not t then return nil end
        local ok, r = pcall(require, t)
        return (ok and type(r) == "table") and r or nil
    end

    local _gfFCCache = nil
    local function _gfLocalItems()
        if not _gfFCCache then
            local _, ctrl = _gfPlayerModules()
            local fc = ctrl and ctrl:FindFirstChild("FighterController")
            if fc then local ok, r = pcall(require, fc); if ok then _gfFCCache = r end end
        end
        if type(_gfFCCache) ~= "table" then return {} end
        local fighter = _gfFCCache.LocalFighter
        local items = type(fighter) == "table" and rawget(fighter, "Items") or nil
        return type(items) == "table" and items or {}
    end

    local function _gfItemById(oid)
        for _, item in next, _gfLocalItems() do
            local d = rawget(item, "Data")
            if d ~= nil and oid == rawget(d, "ObjectID") then return item end
        end
        return nil
    end

    local function _gfInstall(clientItem, remote, decode)
        if _gfHook.installed then return true end
        local inputMethod = rawget(clientItem, "Input")
        if type(inputMethod) ~= "function" then return false, "no Input method" end
        local scratch = Instance.new("RemoteEvent")
        local fireNative = clonefunction(scratch.FireServer)
        local function fireServer(_, objectId, encodedType, args)
            local packet = { block = false, objectId = objectId, type = decode(encodedType), args = args }
            for _, h in ipairs(_gfHook.handlers) do
                local ok, err = pcall(h, packet)
                if not ok then _gfReport("handler", err) end
                if packet.block then break end
            end
            if packet.block then return end
            return fireNative(remote, objectId, encodedType, args, nil)
        end
        local remoteTree = { Replication = { Fighter = { UseItem = { FireServer = fireServer } } } }
        local decoy = Color3.new()
        setrawmetatable(decoy, { __index = function() return remoteTree end })
        for idx, val in pairs(debug.getupvalues(inputMethod)) do
            if typeof(val) == "Instance" and val == ReplicatedStorage then
                debug.setupvalue(inputMethod, idx, decoy)
                _gfHook.restore = { method = inputMethod, index = idx, original = val }
                break
            end
        end
        if not _gfHook.restore then
            for _, bundle in pairs(debug.getupvalues(inputMethod)) do
                if type(bundle) == "table" then
                    for k, v in pairs(bundle) do
                        if typeof(v) == "Instance" and v == ReplicatedStorage then
                            bundle[k] = decoy
                            _gfHook.restore = { bundle = bundle, key = k, original = v }
                            break
                        end
                    end
                    if _gfHook.restore then break end
                end
            end
        end
        if not _gfHook.restore then return false, "could not find ReplicatedStorage upvalue" end
        _gfHook.installed = true
        return true
    end

    local function _gfUninstall()
        local r = _gfHook.restore; _gfHook.restore = nil; _gfHook.installed = false
        if not r then return end
        if r.bundle then r.bundle[r.key] = r.original
        else debug.setupvalue(r.method, r.index, r.original) end
    end

    -- Grenade fuse handler
    local _gfFuse = { trajectoryVisual = nil, throwableProto = nil, origStartThrow = nil }

    local function _gfComputeImpact(tv)
        local la = rawget(tv, "_last_args")
        if type(la) ~= "table" then return nil end
        local step = la[4] or 0.05; local cap = la[6] or math.huge
        local sphere = rawget(tv, "_impact_sphere"); local segs = rawget(tv, "_segments")
        if not sphere or type(segs) ~= "table" then return nil end
        local cf = sphere.CFrame; local key
        while true do
            local seg; key, seg = next(segs, key)
            if key == nil then break end
            if seg.CFrame == cf then return math.min(cap, (key - 2) * step) end
        end
        return nil
    end

    local function _gfEnsureStartThrow()
        if _gfFuse.throwableProto then return end
        local t = _gfResolveThrowable(); if not t then return end
        local orig = rawget(t, "_StartThrow"); if type(orig) ~= "function" then return end
        _gfFuse.throwableProto = t; _gfFuse.origStartThrow = orig
        rawset(t, "_StartThrow", function(item, ...)
            if _gfCONFIG.RemoveFuse then rawset(item, "_cook_detonate_delay", nil) end
            return orig(item, ...)
        end)
    end

    local function _gfRestoreStartThrow()
        if not _gfFuse.throwableProto then return end
        rawset(_gfFuse.throwableProto, "_StartThrow", _gfFuse.origStartThrow)
        _gfFuse.throwableProto = nil; _gfFuse.origStartThrow = nil
    end

    table.insert(_gfHook.handlers, function(packet)
        if not _gfCONFIG.GrenadeFuse then return end
        local kind = packet.type
        local isStart  = kind == "StartShooting" or kind == "StartAiming"
        local isFinish = kind == "FinishShooting" or kind == "FinishAiming"
        if not (isStart or isFinish) then return end
        local item = _gfItemById(packet.objectId); if not item then return end
        local info = rawget(item, "Info"); if not info or not rawget(info, "CanCook") then return end
        if isStart then
            _gfFuse.trajectoryVisual = rawget(item, "_trajectory_visual")
            if _gfCONFIG.RemoveFuse then rawset(item, "_cook_detonate_delay", nil) end
            return
        end
        if _gfCONFIG.ExplodeOn == "Throw" then
            packet.args["\3"] = 0
        else
            local fuseTime = nil
            if _gfFuse.trajectoryVisual then
                local ok, v = pcall(_gfComputeImpact, _gfFuse.trajectoryVisual)
                fuseTime = ok and v or nil
            end
            packet.args["\3"] = fuseTime
        end
        _gfFuse.trajectoryVisual = nil
    end)

    local function _gfTryInstall()
        local ci = _gfResolveClientItem(); local remote = _gfResolveRemote(); local decode = _gfResolveDecoder()
        if not ci or not remote or not decode then return false end
        local ok, r, e = pcall(_gfInstall, ci, remote, decode)
        if not ok then _gfReport("install", r); return false end
        if not r then _gfReport("install", e); return false end
        return true
    end

    task.spawn(function()
        while _gfEnv.__InputHookToken == _gfToken and not _gfHook.installed do
            if _gfTryInstall() then break end
            task.wait(_gfCONFIG.RetryInterval)
        end
        while _gfEnv.__InputHookToken == _gfToken do
            if _gfCONFIG.GrenadeFuse and _gfCONFIG.RemoveFuse then
                pcall(_gfEnsureStartThrow)
            elseif _gfFuse.throwableProto then
                pcall(_gfRestoreStartThrow)
            end
            task.wait(_gfCONFIG.RetryInterval)
        end
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        if _gfEnv.__InputHookToken ~= _gfToken then return end
        _gfFCCache = nil; _gfFuse.trajectoryVisual = nil
    end)

    _gfEnv.__InputHookCleanup = function()
        _gfEnv.__InputHookToken = nil
        table.clear(_gfHook.handlers)
        pcall(_gfRestoreStartThrow)
        pcall(_gfUninstall)
        _gfEnv.__InputHookCleanup = nil
    end

    -- UI
    local _grenadeToggle = SecWeapon:Toggle({
        Name = "grenade fuse", Flag = "GrenadeFuse", Default = false,
        Callback = function(v)
            _gfCONFIG.GrenadeFuse = v
        end,
    })
    do
        local dlg = _grenadeToggle:AddDialog({ Name = "grenade fuse" })
        dlg:Dropdown({
            Name = "explode on", Flag = "GrenadeFuseMode",
            Options = { "Impact", "Throw" }, Default = "Impact",
            Callback = function(v)
                _gfCONFIG.ExplodeOn = v
            end,
        })
        dlg:Toggle({
            Name = "remove fuse", Flag = "GrenadeFuseRemove", Default = false,
            Callback = function(v)
                _gfCONFIG.RemoveFuse = v
            end,
        })
    end
