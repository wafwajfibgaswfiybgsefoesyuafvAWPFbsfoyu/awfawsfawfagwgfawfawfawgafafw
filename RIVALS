local THROWABLE_IMAGES = {
    ["Grenade"]            = "rbxassetid://14526777692";
    ["Subspace Tripmine"]  = "rbxassetid://17098773688";
    ["Smoke Grenade"]      = "rbxassetid://16373283577";
    ["Molotov"]            = "rbxassetid://83303332331234";
