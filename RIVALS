local function tbIsScopedIn()
    local item = tbGetEquippedItem();
    if not item then return false end;
    local ii = nil;
    pcall(function() ii = item.ItemInterface end);
    if not ii then return false end;
    local active = false;
    pcall(function() active = ii:IsScopeActive() end);
    return active == true;
end;

local function tbFire()
    local mc = GetMechanicsController();
    if not mc then return false end;
    local lf = nil;
    pcall(function() lf = mc.LocalFighter end);
    if not lf then return false end;
    local item = nil;
    pcall(function() item = lf.EquippedItem end);
    if not item then return false end;
    local weaponName = nil;
    pcall(function() weaponName = item.Name end);
    if weaponName and weaponstricted(weaponName) then return false end;
    if combatMods.TriggerbotScopeCheck and tbIsScopedWeapon(item) and not tbIsScopedIn() then
        return false;
    end;
    local beforeShot = _lastRealShotTime;
    local okStart = pcall(function()
        mc:EquippedItemInput("StartShooting");
    end);
    if not okStart then return false end;
    task.delay(0.03, function()
        pcall(function()
            mc:EquippedItemInput("FinishShooting");
        end);
    end);
    if _lastRealShotTime == beforeShot then
        return false;
    end;
    return true;
end;

local _lastTBShot        = 0;
local _tbCachedTarget    = nil;
local _tbCacheValid      = false;
local _tbCacheExpiry     = 0;
local _TB_CACHE_TTL      = 0.05;
-- Reaction time tracking: which char the timer is counting for, and since when.
local _tbReactionTarget  = nil;
local _tbReactionSince   = 0;

local function _triggerbotFrame()
    local now = tick();
    if now - _lastTBShot < (combatMods.TriggerbotDelay or 0) + 0.01 then
        return;
    end;
    local target;
    if _tbCacheValid and now < _tbCacheExpiry then
        target = _tbCachedTarget;
        if target and not target.Parent then
            target = nil;
            _tbCacheValid = false;
        end;
    else
        target = tbFindTarget();
        _tbCachedTarget = target;
        _tbCacheValid   = true;
        _tbCacheExpiry  = now + _TB_CACHE_TTL;
    end;
    if not target then
        _tbReactionTarget = nil;
        _tbReactionSince  = 0;
        return;
    end;
    -- Death check: target may have died while in cache.
    local _tbHum = target:FindFirstChildOfClass("Humanoid");
    if not _tbHum or _tbHum.Health <= 0 then
        _tbCachedTarget   = nil;
        _tbCacheValid     = false;
        _tbReactionTarget = nil;
        _tbReactionSince  = 0;
        return;
    end;
    -- Katana check: skip firing while target is deflecting.
    if targetingCfg.katanaCheck then
        local _tbPlayer = PlayersService:GetPlayerFromCharacter(target);
        if _tbPlayer and katanadeflect(_tbPlayer) then
            _tbCachedTarget = nil;
            _tbCacheValid   = false;
            return;
        end;
    end;
    -- Reaction time gate: the crosshair must have rested on this target long enough.
    local reactionTime = combatMods.TriggerbotReactionTime or 0;
    if _tbReactionTarget ~= target then
        _tbReactionTarget = target;
        _tbReactionSince  = now;
        if reactionTime > 0 then return end;
    elseif now - _tbReactionSince < reactionTime then
        return;
    end;
    if not tbShouldFire() then return end;
    local fired = tbFire();
    if not fired then return end;
    _lastTBShot = tick();
    _tbCachedTarget = nil;
    _tbCacheValid   = false;
    _tbCacheExpiry  = 0;
end;
_RegisterHeartbeat(LPH_NO_VIRTUALIZE(function()
    if not combatMods.Triggerbot then
        _tbCachedTarget   = nil;
        _tbCacheValid     = false;
        _tbReactionTarget = nil;
        _tbReactionSince  = 0;
        return;
    end;
    pcall(_triggerbotFrame);
end));

