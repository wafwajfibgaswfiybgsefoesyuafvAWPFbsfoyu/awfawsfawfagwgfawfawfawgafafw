        local _vmMatEnabled   = false
        local _vmMatConn      = nil
        local _vmMatConfig    = { material = Enum.Material.Neon, color = Color3.fromRGB(255, 105, 180) }
        local _vmMatOriginals = {}     -- [part] = { material, color, textures = {[inst] = saved} }
        local _vmMatLastModels = nil   -- model instances seen on the last walk (identity tracking)
        local _vmMatLastCounts = nil   -- [model] = child count on the last walk
        local _vmMatLastWalk   = 0
        local _vmMatForce      = false

        local function vmMatRestorePart(part)
            local orig = _vmMatOriginals[part]
            if not orig then return end
            pcall(function()
                if part.Parent then
                    part.Material = orig.material
                    part.Color    = orig.color
                end
                -- iterate the CACHED texture instances: unparented
                -- SurfaceAppearances no longer appear in part:GetChildren()
                for tx, saved in pairs(orig.textures) do
                    if saved == "disabled" then
                        if tx:IsA("SurfaceAppearance") and tx.Parent == nil then
                            tx.Parent = part
                        end
                    elseif (tx:IsA("Texture") or tx:IsA("Decal")) and tx.Parent ~= nil then
                        tx.Transparency = saved
