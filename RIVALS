            _vmMatForce = true
            _vmMatConn = _RegisterRenderStepped(LPH_NO_VIRTUALIZE(function()
                vmMatWalk(_vmMatForce)
                _vmMatForce = false
            end))
        end
        local _vmMatToggle = GunGroup:Toggle({
            Name = "gun material", Flag = "VmMaterialEnabled", Default = false,
