                        elseif ItemName == "satchel" then label = ThrowType == "Lob" and "lobbing satchel" or "throwing satchel"
                        end;
                        table.insert(Flags, label);
                    end;
                end;
            end;

            if V["level"] then
                local lvl = GetLeaderstat(Player, "Level");
                if lvl ~= nil then table.insert(Flags, "LVL " .. tostring(lvl)) end;
            end;
            if V["rank"] then
                table.insert(Flags, GetPlayerRank(Player));
            end;
            if V["winstreak"] then
                local ws = GetLeaderstat(Player, "Win Streak");
                if ws ~= nil then
