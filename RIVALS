local _origInfoCache = {};
combatMods._origInfoCache = _origInfoCache;
local function _cacheOrig(item, key)
    if not item or not item.Info then return nil end;
    local id = nil;
    pcall(function() id = item:Get("ObjectID") end);
    if not id then return nil end;
    if not _origInfoCache[id] then _origInfoCache[id] = {} end;
    if _origInfoCache[id][key] == nil then
        local cur = nil;
        pcall(function() cur = item.Info[key] end);
        _origInfoCache[id][key] = cur;
    end;
    return _origInfoCache[id][key];
end;

local function _restoreOrig(item, key)
    if not item or not item.Info then return end;
    local id = nil;
    pcall(function() id = item:Get("ObjectID") end);
    if not id then return end;
    if _origInfoCache[id] and _origInfoCache[id][key] ~= nil then
        item.Info[key] = _origInfoCache[id][key];
    end;
end;

