            Melee = {
                ["Battle Axe"]=true, ["Chainsaw"]=true, ["Fists"]=true, ["Glast Shard"]=true,
                ["Katana"]=true, ["Knife"]=true, ["Maul"]=true, ["Riot Shield"]=true,
