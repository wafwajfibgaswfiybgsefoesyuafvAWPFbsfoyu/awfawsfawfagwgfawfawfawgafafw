        local function vmMatWalk(force)
            local viewmodels = workspace:FindFirstChild("ViewModels")
            if not viewmodels then return end
            local fp = viewmodels:FindFirstChild("FirstPerson")
            if not fp then return end
            local models = {}
            for _, model in ipairs(fp:GetChildren()) do
                if model:IsA("Model") then table.insert(models, model) end
            end
            -- re-apply whenever ANYTHING changes: the model instance itself
            -- (each weapon has its OWN viewmodel model, so switching weapons
            -- swaps instances even though the child count stays identical),
            -- the model's internal structure (re-equip rebuilds ItemVisual),
            -- a forced walk (config change), or the periodic safety re-check.
            local changed = force or (_vmMatLastModels == nil)
            if not changed then
                if #models ~= #_vmMatLastModels then
                    changed = true
                else
                    for i, m in ipairs(models) do
                        if m ~= _vmMatLastModels[i] then changed = true break end
                    end
                    if not changed then
                        for _, m in ipairs(models) do
                            if (_vmMatLastCounts[m] or -1) ~= #m:GetChildren() then changed = true break end
                        end
                    end
                end
            end
            if not changed and (tick() - _vmMatLastWalk) > 1 then changed = true end
            _vmMatLastModels = models
            _vmMatLastCounts = {}
            for _, m in ipairs(models) do _vmMatLastCounts[m] = #m:GetChildren() end
            _vmMatLastWalk = tick()
