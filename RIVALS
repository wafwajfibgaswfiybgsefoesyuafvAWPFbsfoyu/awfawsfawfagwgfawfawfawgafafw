                        elseif ItemName == "flashbang" then label = ThrowType == "Lob" and "lobbing flash" or "throwing flash"
                        elseif ItemName == "smoke grenade" then label = ThrowType == "Lob" and "lobbing smoke" or "throwing smoke"
