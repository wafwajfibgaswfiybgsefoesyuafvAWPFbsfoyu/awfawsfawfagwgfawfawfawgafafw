    function SwapAudio(WeaponName, SkinName)
        if not LogicAssets then return end;
        local Folder = FindModel(LogicAssets, WeaponName);
        if not Folder then return end;

        if not SkinName then
            RollbackAudio();
            return;
        end;

        local SkinModule = Folder:FindFirstChild(SkinName);
        if not SkinModule then
            SkinModule = FindModel(Folder, SkinName);
        end;
        if not SkinModule then return end;

        local Ok, SkinData = pcall(require, SkinModule);
        if not Ok or type(SkinData) ~= "table" then return end;

        local Swapped = 0;
        for _, Module in ipairs(Folder:GetChildren()) do
            if Module:IsA("ModuleScript") and Module ~= SkinModule then
                local LoadedOk, Data = pcall(require, Module);
                if LoadedOk and type(Data) == "table" then
                    local Backup = SoundsBackup[Module] or {};
                    SoundsBackup[Module] = Backup;
                    for _, Key in ipairs(AudioKeys) do
                        local Value = SkinData[Key];
                        if Value ~= nil then
                            if Backup[Key] == nil then Backup[Key] = Data[Key] end;
                            Data[Key] = Value;
                            Swapped = Swapped + 1;
                        end;
                    end;
                end;
            end;
        end;
    end;

