do
    local Camera   = game:GetService("Workspace").CurrentCamera;
    local RunService = game:GetService("RunService");
    local Workspace = game:GetService("Workspace");
    local LocalPlayer = game:GetService("Players").LocalPlayer;

    local ThrowableGui = Instance.new("ScreenGui");
    ThrowableGui.Name = "ThrowableESP";
    ThrowableGui.ResetOnSpawn = false;
    ThrowableGui.IgnoreGuiInset = true;
    ThrowableGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling;
    ThrowableGui.DisplayOrder = 9998;
    pcall(function()
        ThrowableGui.Parent = (gethui and gethui()) or game:GetService("CoreGui");
    end);

    local Pool = {};
    local GradClock = 0;

    local function MakeGradSeq(C1, C2)
        local Mid = C1:Lerp(C2, 0.5);
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0,    C1);
            ColorSequenceKeypoint.new(0.35, Mid);
            ColorSequenceKeypoint.new(0.5,  C2);
            ColorSequenceKeypoint.new(0.65, Mid);
            ColorSequenceKeypoint.new(1,    C1);
        });
    end

    local function GetOrCreate(Model)
        if Pool[Model] then
            Pool[Model].LastSeen = tick();
            return Pool[Model];
        end

        local Container = Instance.new("Frame");
        Container.Name = "Throwable_" .. Model.Name;
        Container.BackgroundTransparency = 1;
        Container.BorderSizePixel = 0;
        Container.Size = UDim2.new(0, 0, 0, 0);
        Container.Parent = ThrowableGui;

local NameLbl = Instance.new("TextLabel");
        NameLbl.Name = "Name";
        NameLbl.BackgroundTransparency = 1;
        NameLbl.BorderSizePixel = 0;
        NameLbl.Text = Model.Name;
        NameLbl.TextColor3 = Color3.fromRGB(255, 255, 255);
        NameLbl.TextSize = 12;
        if ProggyCleanFont then NameLbl.FontFace = ProggyCleanFont end;
        NameLbl.TextXAlignment = Enum.TextXAlignment.Center;
        NameLbl.TextYAlignment = Enum.TextYAlignment.Center;
        NameLbl.Visible = false;
        NameLbl.Parent = Container;
        if ProggyCleanFont then NameLbl.FontFace = ProggyCleanFont end;

        local NameStroke = Instance.new("UIStroke");
        NameStroke.Color = Color3.fromRGB(0, 0, 0);
        NameStroke.Thickness = 1;
        NameStroke.LineJoinMode = Enum.LineJoinMode.Miter;
        NameStroke.Parent = NameLbl;

        local NameGrad = Instance.new("UIGradient");
        NameGrad.Rotation = 0;
        NameGrad.Parent = NameLbl;

        local ImgLbl = Instance.new("ImageLabel");
        ImgLbl.Name = "Icon";
        ImgLbl.BackgroundTransparency = 1;
        ImgLbl.BorderSizePixel = 0;
        ImgLbl.ScaleType = Enum.ScaleType.Fit;
        ImgLbl.Image = "";
        ImgLbl.Visible = false;
        ImgLbl.Parent = Container;

        local DistLbl = Instance.new("TextLabel");
        DistLbl.Name = "Dist";
        DistLbl.BackgroundTransparency = 1;
        DistLbl.BorderSizePixel = 0;
        DistLbl.Text = "";
        DistLbl.TextColor3 = Color3.fromRGB(255, 255, 255);
        DistLbl.TextSize = 12;
DistLbl.TextXAlignment = Enum.TextXAlignment.Center;
        DistLbl.TextYAlignment = Enum.TextYAlignment.Center;
        DistLbl.Visible = false;
        DistLbl.Parent = Container;
        if ProggyCleanFont then DistLbl.FontFace = ProggyCleanFont end;

        local DistStroke = Instance.new("UIStroke");
        DistStroke.Color = Color3.fromRGB(0, 0, 0);
        DistStroke.Thickness = 1;
        DistStroke.LineJoinMode = Enum.LineJoinMode.Miter;
        DistStroke.Parent = DistLbl;

        local DistGrad = Instance.new("UIGradient");
        DistGrad.Rotation = 0;
        DistGrad.Parent = DistLbl;

        local Entry = {
            Frame     = Container;
            NameLbl   = NameLbl;
            DistLbl   = DistLbl;
            ImgLbl    = ImgLbl;
            NameGrad  = NameGrad;
            DistGrad  = DistGrad;
            LastSeen  = tick();
        };
        Pool[Model] = Entry;
        return Entry;
    end

    local function CleanPool()
        for Model, Entry in Pool do
            if not Model.Parent or (tick() - Entry.LastSeen > 2) then
                Entry.Frame:Destroy();
                Pool[Model] = nil;
            end
        end
    end

    RunService:BindToRenderStep("ThrowableESP", Enum.RenderPriority.Camera.Value + 1, LPH_NO_VIRTUALIZE(function()
        if not ThrowableState.Enabled then
            for _, Entry in Pool do
                Entry.Frame.Visible = false;
            end
            return;
        end

        GradClock = (GradClock + 0.016 * 0.45) % 2;
        local GradOff = (GradClock % 2) - 1;
        local GradOffV = Vector2.new(GradOff, 0);

        local CamPos   = Camera.CFrame.Position;
        local ShowName  = ThrowableState.NameEsp;
        local ShowDist  = ThrowableState.DistEsp;
        local ShowImg   = ThrowableState.ImageEsp;
        local ImgSize   = ThrowableState.ImageSize;
        local MaxDist   = ThrowableState.MaxDist;
        local Active    = ThrowableState.ActiveTypes;

for _, Child in Workspace:GetChildren() do
            if not Child:IsA("Model") then continue end;
            local Name = Child.Name;
            if Name == "SubspaceTripmineHitbox" then
                Name = "Subspace Tripmine";
            end;
            local Base = BASE_THROWABLE_MAP[Name];
            if not Base then
                -- Skinned throwables: model name is the skin name.
                -- Check children for a part/model whose name is a known base type.
                for _, Desc in Child:GetChildren() do
                    local DescBase = BASE_THROWABLE_MAP[Desc.Name];
                    if DescBase then
                        Base = DescBase;
                        Name = Desc.Name;
                        break;
                    end;
                end;
            end;
            if not Base then continue end;

            if not Active[Base] then continue end;

            local Pos;
            local PrimaryPart = Child.PrimaryPart or Child:FindFirstChildWhichIsA("BasePart");
            if PrimaryPart then
                Pos = PrimaryPart.Position;
            else
                pcall(function() Pos = Child:GetPivot().Position end);
            end;
            if not Pos then continue end;

            local Dist = (CamPos - Pos).Magnitude;
            if Dist > MaxDist then continue end;

            local ScreenPos = Camera:WorldToViewportPoint(Pos);
            local OnScreen = ScreenPos.Z > 0;
            if not OnScreen then continue end;

            local Entry = GetOrCreate(Child);
            local Frame = Entry.Frame;
            Frame.Visible = true;

local SX = ScreenPos.X;
            local SY = ScreenPos.Y - 36;

            local YOffset = 0;
            local HalfImg = ImgSize / 2;

            local RightSP = Camera:WorldToScreenPoint(Pos + Vector3.new(0.4, 0, 0));
            local PixelsPerStud = math.max(8, math.abs(RightSP.X - SX) / 0.4);
            local WorldPixels = math.clamp(math.floor(PixelsPerStud * 6), 60, 220);
            HalfImg = WorldPixels / 2;

            if ShowImg then
                local Img = Entry.ImgLbl;
                Img.Image = THROWABLE_IMAGES[Base] or "";
                Img.Size = UDim2.fromOffset(WorldPixels, WorldPixels);
                Img.Position = UDim2.fromOffset(SX - HalfImg, SY - HalfImg);
                Img.Visible = true;
            else
                Entry.ImgLbl.Visible = false;
            end

            if ShowName then
                local Lbl = Entry.NameLbl;
                Lbl.Text = Name;
                Lbl.Size = UDim2.new(0, 200, 0, 12);
                Lbl.AnchorPoint = Vector2.new(0.5, 1);
                Lbl.Position = UDim2.fromOffset(SX, SY - HalfImg + 2);
                Lbl.Visible = true;
                Entry.NameGrad.Color = MakeGradSeq(ThrowableState.NameColor, ThrowableState.NameColor2);
                Entry.NameGrad.Offset = GradOffV;
            else
                Entry.NameLbl.Visible = false;
            end

            if ShowDist then
                local Lbl = Entry.DistLbl;
                local S = _G_ESPState;
                local DUnit = (S and S.DistanceUnit == "meters") and "m" or "st";
                local DVal  = (DUnit == "m") and math.floor(Dist * 0.28) or math.floor(Dist);
                Lbl.Text = tostring(DVal) .. " " .. DUnit;
                Lbl.Size = UDim2.new(0, 200, 0, 12);
                Lbl.AnchorPoint = Vector2.new(0.5, 0);
                Lbl.Position = UDim2.fromOffset(SX, SY + HalfImg - 2);
                Lbl.Visible = true;
                Entry.DistGrad.Color = MakeGradSeq(ThrowableState.DistColor, ThrowableState.DistColor2);
                Entry.DistGrad.Offset = GradOffV;
            else
                Entry.DistLbl.Visible = false;
            end
        end

        for Model, Entry in Pool do
            if Entry.Frame.Visible and (tick() - Entry.LastSeen > 0.1) then
                Entry.Frame.Visible = false;
            end
        end

        CleanPool();
    end));

    game:GetService("Players").LocalPlayer.AncestryChanged:Connect(function()
        ThrowableGui:Destroy();
    end);
end;

TabSettings:ApplySettings();

Library:KeystrokeOverlay();

Library:KeybindList({ Title = "Keybinds" });

Library:TargetHUD();
do
        local _ReplicatedStorage = game:GetService("ReplicatedStorage");
        local _Players           = game:GetService("Players");
        local _LocalPlayer       = _Players.LocalPlayer;

        local _ItemLib = nil;
        local function _GetItemLib()
                if _ItemLib ~= nil then return _ItemLib end;
                local ok, lib = pcall(function()
                        return require(_ReplicatedStorage:WaitForChild("Modules"):WaitForChild("ItemLibrary"));
                end);
                _ItemLib = ok and lib or false;
                return _ItemLib;
        end;

        local _FC = nil;
        local function _GetFC()
                if _FC ~= nil then return _FC end;
                local ok, fc = pcall(function()
                        return require(_LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("Controllers"):WaitForChild("FighterController"));
                end);
                _FC = ok and fc or false;
                return _FC;
        end;

        local function _GetEquippedWeaponName(player)
                if not player then return nil end;
                local fc = _GetFC();
                if not fc then return nil end;
                local fighter;
                local ok = pcall(function() fighter = fc:GetFighter(player) end);
                if not ok or not fighter then return nil end;
                local item;
                pcall(function() item = fighter.EquippedItem end);
                if not item then return nil end;
                local name;
                pcall(function() name = item.Name end);
                return (name and name ~= "") and name or nil;
        end;

        local function _GetWeaponIcon(weaponName)
                if not weaponName or weaponName == "" then return nil end;
                local lib = _GetItemLib();
                if lib and lib.ViewModels then
                        local vm = lib.ViewModels[weaponName];
                        if vm then
                                return vm.ImageHighResolution or vm.Image;
                        end;
                        if lib.Items and lib.Items[weaponName] then
                                local baseName;
                                pcall(function() baseName = lib.Items[weaponName].Base end);
                                if baseName and lib.ViewModels[baseName] then
                                        return lib.ViewModels[baseName].ImageHighResolution or lib.ViewModels[baseName].Image;
                                end;
                        end;
                end;
                local _fallback = {
                        ["Knife"]          = "rbxassetid://86335100734691";
                        ["Assault Rifle"]  = "rbxassetid://101393097640802";
                        ["Sniper"]         = "rbxassetid://132853334508822";
                        ["Handgun"]        = "rbxassetid://113347796650411";
                        ["Shotgun"]        = "rbxassetid://113217458668564";
                        ["SMG"]            = "rbxassetid://113347796650411";
                        ["RPG"]            = "rbxassetid://95169761396387";
                        ["Katana"]         = "rbxassetid://94254432866649";
                        ["Flare Gun"]      = "rbxassetid://113217458668564";
                        ["Fists"]          = "rbxassetid://99106504223200";
                        ["Medkit"]         = "rbxassetid://113536105409271";
                        ["Grenade"]        = "rbxassetid://132057045886696";
                        ["Flashbang"]      = "rbxassetid://129373270164561";
                        ["Molotov"]        = "rbxassetid://72190971541032";
                };
                local lowerName = weaponName:lower();
                for name, id in pairs(_fallback) do
                        if name:lower() == lowerName then
                                return id;
                        end;
                end;
                return nil;
        end;

        local function _ResolveTarget(wantRagebot, wantLegitbot, wantSilent)
                if wantRagebot then
                        local fn = getgenv()._RivalsRagebotTarget;
                        if fn then
                                local char, plr = fn();
                                if char then
                                        return char, plr, "ragebot";
                                end;
                        end;
                end;
                if wantSilent then
                        local sa = getgenv()._RivalsSilentAim;
                        if sa and sa.enabled then
                                local fn = getgenv()._RivalsLegitbotTarget;
                                if fn then
                                        local char = fn();
                                        if char then
                                                local plr = _Players:GetPlayerFromCharacter(char);
                                                return char, plr, "silent";
                                        end;
                                end;
                        end;
                end;
                if wantLegitbot then
                        local aim = getgenv()._RivalsAimbotState;
                        if aim and aim.enabled and aim.lockedTarget then
                                local char = aim.lockedTarget;
                                local plr = _Players:GetPlayerFromCharacter(char);
                                return char, plr, "aimbot";
                        end;
                        local fn = getgenv()._RivalsLegitbotTarget;
                        if fn then
                                local char = fn();
                                if char then
                                        local plr = _Players:GetPlayerFromCharacter(char);
                                        return char, plr, "legitbot";
                                end;
                        end;
                end;
                return nil, nil, nil;
        end;

        local function _GetDistance(char)
                if not char then return nil end;
                local myChar = _LocalPlayer.Character;
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart");
                local tRoot  = char:FindFirstChild("HumanoidRootPart");
                if not tRoot then
                        local wrapper = char:FindFirstChild("EnemyHumanoid");
                        if wrapper then
                                tRoot = wrapper:FindFirstChild("HumanoidRootPart");
                        end;
                end;
                if not myRoot or not tRoot then return nil end;
                return (tRoot.Position - myRoot.Position).Magnitude;
        end;

        local _targetHudConn = nil;
        local _targetHudAcc = 0;
        local _hudFollowX, _hudFollowY = nil, nil;
        Library._TargetHUD_StartUpdate = function()
                if _targetHudConn then return end;
                local RunService = game:GetService("RunService");
                _targetHudConn = _RegisterHeartbeat(LPH_NO_VIRTUALIZE(function(dt)
                        _targetHudAcc = _targetHudAcc + dt;
                        if _targetHudAcc < 0.05 then return end;
                        _targetHudAcc = 0;
                        pcall(function()
                                local hud = Library._TargetHUD;
                                if not hud then return end;
                                if not Library.Flags["TargetHUDEnabled"] then return end;
                                -- perf: cache the TargetHUDSources table once instead of
                                -- indexing Library.Flags twice per HUD update (each index
                                -- is a wrapped table access under Luraph)
                                local _srcs = Library.Flags["TargetHUDSources"] or {};
                                local wantRagebot  = _srcs["ragebot"] == true;
                                local wantLegitbot = _srcs["legitbot"] == true;
                                local wantSilent   = _srcs["silent"] == true;
                                if not (wantRagebot or wantLegitbot or wantSilent) then
                                        wantRagebot  = true;
                                        wantLegitbot = true;
                                        wantSilent   = true;
                                end;
                                local char, player, source = _ResolveTarget(wantRagebot, wantLegitbot, wantSilent);
                                if not char then
                                        hud:ClearTarget();
                                        return;
                                end;
                                hud:SetTarget();
                                local isDummy = (player == nil);

                                -- follow ragebot target (visual only): lerp the HUD next to the target
                                if Library.Flags["TargetHUDFollowRage"] then
                                        local _troot = nil;
                                        pcall(function()
                                                _troot = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart;
                                        end);
                                        local _vp, _on;
                                        if _troot then
                                                pcall(function()
                                                        _vp, _on = workspace.CurrentCamera:WorldToViewportPoint(_troot.Position + Vector3.new(0, 3, 0));
                                                end);
                                        end;
                                        if _vp and _on and ((_vp.Z or 0) > 0) then
                                                local _a = math.clamp(Library.Flags["TargetHUDFollowRageLerp"] or 0.35, 0.01, 1);
                                                local _tpx, _tpy = _vp.X + 90, _vp.Y;
                                                if not _hudFollowX then
                                                        _hudFollowX, _hudFollowY = _tpx, _tpy;
                                                else
                                                        _hudFollowX = _hudFollowX + (_tpx - _hudFollowX) * _a;
                                                        _hudFollowY = _hudFollowY + (_tpy - _hudFollowY) * _a;
                                                end;
                                                local _hw = (hud.Frame and hud.Frame.AbsoluteSize.X) or 260;
                                                pcall(function()
                                                        hud.Frame.Position = UDim2.fromOffset(_hudFollowX - _hw * 0.5, _hudFollowY);
                                                end);
                                        else
                                                _hudFollowX, _hudFollowY = nil, nil;
                                        end;
                                else
                                        _hudFollowX, _hudFollowY = nil, nil;
                                end;

                                if not isDummy then
                                        hud.Avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. player.UserId .. "&w=150&h=150";
                                else
                                        hud.Avatar.Image = "rbxassetid://124519084257039";
                                end;

                                if not isDummy then
                                        hud.Header.Text = player.DisplayName;
                                else
                                        hud.Header.Text = (char.Name and char.Name ~= "") and char.Name or "Dummy";
                                end;

                                local levelStr = "";
                                local deviceStr = "";
                                local streakNum = 0;
                                if not isDummy then
                                        pcall(function()
                                                local cl = player:FindFirstChild("CustomLeaderstats");
                                                if cl then
                                                        local lv = cl:FindFirstChild("Level");
                                                        if lv then levelStr = tostring(lv.Value) end;
                                                        local ws = cl:FindFirstChild("Win Streak");
                                                        if ws then
                                                                local n = tonumber(ws.Value);
                                                                if n then streakNum = n end;
                                                        end;
                                                end;
                                        end);
                                        pcall(function()
                                                local fc = _GetFC();
                                                if fc then
                                                        local fighter = fc:GetFighter(player);
                                                        if fighter then
                                                                local dev = nil;
                                                                pcall(function() dev = fighter:Get("Controls") end);
                                                                if dev then
                                                                        deviceStr = tostring(dev):lower();
                                                                else
                                                                        pcall(function() dev = fighter:Get("Device") end);
                                                                        if dev then deviceStr = tostring(dev):lower() end;
                                                                end;
                                                        end;
                                                end;
                                        end);
                                else
                                        levelStr = "-";
                                        deviceStr = "-";
                                end;
                                hud.MetaLine.Text = "level: " .. levelStr .. "  device: " .. deviceStr .. "  [" .. (source or "") .. "]";

                                if streakNum > 0 then
                                        hud.StreakBadge.Text = "";
                                else
                                        hud.StreakBadge.Text = "";
                                end;

                                local weaponName = "";
                                local ammoStr = "-";
                                if not isDummy then
                                        weaponName = _GetEquippedWeaponName(player) or "";
                                else
                                        weaponName = "Assault Rifle";
                                end;
                                hud.WeaponValue.Text = weaponName ~= "" and weaponName or "—";

                                if not isDummy then
                                        pcall(function()
                                                local fc = _GetFC();
                                                if fc then
